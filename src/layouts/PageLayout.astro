---
import BaseLayout from './BaseLayout.astro';
import { SITE, capabilityPages } from '../data/site';

interface Props { page: any; lead?: string; banner?: boolean; chips?: string[]; badge?: string; compact?: boolean }
const { page, lead, banner = false, chips = [], badge, compact = false } = Astro.props;
const tight = compact || Astro.slots.has('aside');
const noindex = Boolean(page.stub || page.draft);
const isIndustry = page.path.startsWith('/industries/');
const section = isIndustry
  ? { name: 'Industries', to: '/#industries' }
  : capabilityPages.some((entry) => entry.path === page.path) ? { name: 'Engineering', to: null } : null;

const crumbs = [
  { name: 'Home', item: `${SITE.url}/` },
  ...(section?.to ? [{ name: section.name, item: `${SITE.url}${section.to}` }] : []),
  { name: page.label, item: `${SITE.url}${page.path}` },
];
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((entry, index) => ({ '@type': 'ListItem', position: index + 1, ...entry })),
};
---
<BaseLayout title={page.title} description={page.description} path={page.path} noindex={noindex} jsonLd={[breadcrumbLd]}>
  <main>
    {banner ? (
      <header class={`relative overflow-hidden bg-gradient-to-br from-primary via-[#0B2D5B] to-secondary text-white ${tight ? 'pb-8 pt-24 sm:pb-10 sm:pt-28' : 'pb-14 pt-28 sm:pb-20 sm:pt-36'}`}>
        <div class="cfd-grid pointer-events-none absolute inset-0 opacity-10" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -right-20 -top-20 h-80 w-80 rounded-full bg-accent/20 blur-[100px]" aria-hidden="true"></div>
        <div class="site-container relative">
          <nav aria-label="Breadcrumb" class={`text-sm text-slate-300 ${tight ? 'mb-3' : 'mb-6'}`}>
            <ol class="flex flex-wrap items-center gap-2">
              <li><a href="/" class="hover:text-white">Home</a></li>
              {section && <li aria-hidden="true">/</li>}
              {section && <li>{section.to ? <a href={section.to} class="hover:text-white">{section.name}</a> : section.name}</li>}
              <li aria-hidden="true">/</li>
              <li aria-current="page" class="font-semibold text-white">{page.label}</li>
            </ol>
          </nav>
          <div class={Astro.slots.has('aside') ? 'grid items-center gap-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:gap-10' : ''}>
            <div class="min-w-0">
              <span class="inline-block rounded-full bg-accent px-3 py-1 text-xs font-bold uppercase tracking-widest text-white">{badge ?? (isIndustry ? 'Industry solutions' : 'Engineering capability')}</span>
              <h1 class="mt-4 max-w-4xl font-heading text-[clamp(2rem,4.8vw,3.3rem)] font-bold leading-[1.12] text-white">{page.h1}</h1>
              <p class="mt-5 max-w-3xl font-body text-lg leading-8 text-slate-200">{lead ?? page.intro}</p>
              {chips.length > 0 && (
                <ul class="mt-8 flex flex-wrap gap-2.5" aria-label="Key topics">
                  {chips.map((chip) => <li class="rounded-full border border-white/25 bg-white/10 px-4 py-1.5 font-heading text-sm font-medium text-white backdrop-blur">{chip}</li>)}
                </ul>
              )}
            </div>
            {Astro.slots.has('aside') && <div class="min-w-0"><slot name="aside" /></div>}
          </div>
        </div>
      </header>
    ) : (
      <header class="border-b border-slate-200 bg-gradient-to-b from-sky-100 to-brand-bg pb-12 pt-28 sm:pb-16 sm:pt-36">
        <div class="site-container">
          <nav aria-label="Breadcrumb" class="mb-6 text-sm text-slate-500">
            <ol class="flex flex-wrap items-center gap-2">
              <li><a href="/" class="hover:text-accent">Home</a></li>
              {section && <li aria-hidden="true">/</li>}
              {section && <li>{section.to ? <a href={section.to} class="hover:text-accent">{section.name}</a> : section.name}</li>}
              <li aria-hidden="true">/</li>
              <li aria-current="page" class="font-medium text-primary">{page.label}</li>
            </ol>
          </nav>
          <h1 class="max-w-4xl font-heading text-[clamp(2rem,4.8vw,3.2rem)] font-bold leading-[1.12] text-primary">{page.h1}</h1>
          <p class="mt-5 max-w-3xl font-body text-lg leading-8 text-slate-600">{lead ?? page.intro}</p>
        </div>
      </header>
    )}
    <div class={`site-container ${compact ? 'py-8 sm:py-10' : 'py-14 sm:py-20'}`}>
      <slot />
    </div>
  </main>
</BaseLayout>
