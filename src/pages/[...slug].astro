---
import { Icon } from 'astro-icon/components';
import PageLayout from '../layouts/PageLayout.astro';
import { CONTACT_BUSINESS, contentPages, capabilityPages, industryPages } from '../data/site';
import { pageContent } from '../data/content';

export function getStaticPaths() {
  // Pages with their own dedicated .astro file go in this list so they are not generated twice.
  const custom: string[] = ['/about-us/', '/engineering-technologies-software/', '/engineering-cafe/', '/contact/'];
  return contentPages
    .filter((page) => !custom.includes(page.path))
    .map((page) => ({ params: { slug: page.path.replace(/^\/|\/$/g, '') }, props: { page } }));
}

const { page } = Astro.props;
const content = (pageContent as Record<string, any>)[page.path];
const siblings = (page.path.startsWith('/industries/') ? industryPages : capabilityPages.some((p) => p.path === page.path) ? capabilityPages : []).filter((p) => p.path !== page.path);
const listClass = 'max-w-3xl list-disc space-y-2 pl-5 font-body text-base leading-relaxed text-slate-600 marker:text-accent';
---
<PageLayout page={page}>
  {page.stub && (
    <p role="note" class="mt-10 max-w-3xl rounded-xl border border-dashed border-slate-300 bg-white p-5 font-body text-sm leading-relaxed text-slate-500">Detailed content for this page is in preparation.</p>
  )}

  {content && (
    <>
      <section aria-labelledby="focus-heading" class="mt-14 sm:mt-16">
        <h2 id="focus-heading" class="font-heading text-xl font-bold text-primary sm:text-2xl">{content.focusHeading}</h2>
        <ul class="mt-5 grid gap-4 sm:grid-cols-2">
          {content.focus.map((item: any) => (
            <li class="rounded-2xl border border-slate-200 bg-white p-6">
              <h3 class="font-heading text-base font-bold text-primary">{item.title}</h3>
              <p class="mt-2 font-body text-sm leading-relaxed text-slate-600">{item.text}</p>
            </li>
          ))}
        </ul>
      </section>

      {content.questions && (
        <section aria-labelledby="questions-heading" class="mt-14 sm:mt-16">
          <h2 id="questions-heading" class="font-heading text-xl font-bold text-primary sm:text-2xl">Questions we help answer</h2>
          <ul class:list={['mt-5', listClass]}>{content.questions.map((q: string) => <li>{q}</li>)}</ul>
        </section>
      )}

      <section aria-labelledby="deliverables-heading" class="mt-14 sm:mt-16">
        <h2 id="deliverables-heading" class="font-heading text-xl font-bold text-primary sm:text-2xl">What you can expect</h2>
        <ul class:list={['mt-5', listClass]}>{content.deliverables.map((d: string) => <li>{d}</li>)}</ul>
      </section>

      <section aria-labelledby="links-heading" class="mt-14 sm:mt-16">
        <h2 id="links-heading" class="font-heading text-xl font-bold text-primary sm:text-2xl">{page.path.startsWith('/industries/') ? 'Relevant capabilities' : 'Related expertise'}</h2>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {content.links.map((entry: any) => (
            <li>
              <a href={entry.to} class="group block h-full rounded-xl border border-slate-200 bg-white p-5 transition hover:border-accent/40">
                <span class="flex items-center justify-between gap-3 font-heading text-sm font-bold text-primary group-hover:text-accent">{entry.label} <Icon name="ion:arrow-forward" class="h-4 w-4" aria-hidden="true" /></span>
                <span class="mt-1 block font-body text-sm text-slate-500">{entry.why}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </>
  )}

  {!content && siblings.length > 0 && (
    <section aria-labelledby="related-heading" class="mt-14 sm:mt-16">
      <h2 id="related-heading" class="font-heading text-xl font-bold text-primary sm:text-2xl">More in {page.path.startsWith('/industries/') ? 'Industries' : 'Engineering'}</h2>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {siblings.map((entry) => (
          <li><a href={entry.path} class="flex min-h-12 items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-5 font-body text-sm font-semibold text-slate-700 transition hover:border-accent/40 hover:text-accent">{entry.label} <Icon name="ion:arrow-forward" class="h-4 w-4" aria-hidden="true" /></a></li>
        ))}
      </ul>
    </section>
  )}

  {page.path !== '/contact/' && (
    <div class="mt-16">
      <a href={CONTACT_BUSINESS} class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-accent px-6 font-heading text-sm font-semibold text-white shadow-lg shadow-accent/20 transition hover:-translate-y-0.5 hover:bg-accent-dark">
        Discuss an Engineering Challenge <Icon name="ion:arrow-forward" class="h-4 w-4" aria-hidden="true" />
      </a>
    </div>
  )}
</PageLayout>
