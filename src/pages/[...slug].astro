---
import PageLayout from '../layouts/PageLayout.astro';
import DocPage from '../components/pages/DocPage.astro';
import SimulationPage from '../components/pages/SimulationPage.astro';
import { contentPages, capabilityPages, industryPages } from '../data/site';

export function getStaticPaths() {
  // Pages with their own dedicated .astro file go in this list so they are not generated twice.
  const custom: string[] = ['/about-us/', '/engineering-technologies-software/', '/engineering-cafe/', '/contact/', '/privacy-policy/'];
  return contentPages
    .filter((page) => !custom.includes(page.path))
    .map((page) => ({ params: { slug: page.path.replace(/^\/|\/$/g, '') }, props: { page } }));
}

const { page } = Astro.props;
const capIds: Record<string, string> = {
  '/engineering-simulation/': 'simulation',
  '/chemical-engineering-process-consulting/': 'process',
  '/engineering-design/': 'design',
  '/machine-learning-data-intelligence/': 'ml',
  '/software-automation/': 'software',
};
const indIds: Record<string, string> = {
  'chemical-process': 'chemical', pharmaceuticals: 'pharma', cement: 'cement', 'steel-metals': 'steel', 'oil-gas': 'oil-gas',
  automotive: 'automotive', aerospace: 'aerospace', marine: 'marine', 'food-beverage': 'food',
};
const isCap = capabilityPages.some((p) => p.path === page.path);
const isInd = industryPages.some((p) => p.path === page.path);
const kind = isCap ? 'capability' : 'industry';
const chipsById: Record<string, string[]> = {
  simulation: ['CFD', 'FEA', 'Multiphase flow', 'Combustion & thermal', 'Multiphysics'],
  ml: ['Predictive models', 'Soft sensors', 'Anomaly detection', 'Digital twins', 'Golden batch'],
  software: ['Simulation automation', 'Custom applications', 'ML applications', 'Data integration', 'Digital twins'],
  design: ['Process design', 'Equipment design', 'Scale-up', 'Retrofits'],
  process: ['Troubleshooting', 'Root-cause analysis', 'Optimisation', 'Equipment performance'],
  chemical: ['Process design', 'Reactors', 'Heat & mass transfer', 'Digital twins'],
  pharma: ['Bioreactors', 'Scale-up', 'Crystallisation', 'Process modelling'],
  cement: ['Pyro-process', 'Combustion', 'Cyclones', 'ESP & bag filters'],
  steel: ['Furnaces', 'Thermal processes', 'Monitoring'],
  'oil-gas': ['Separators', 'Tank mixing', 'Fire modelling', 'FEA'],
  automotive: ['Fuel sprays', 'SCR', 'Motor cooling'],
  aerospace: ['Atomisation', 'Propellant', 'Icing'],
  marine: ['Hull hydrodynamics', 'Waves'],
  food: ['Process optimisation', 'Emulsions', 'Quality'],
};
const id = isCap ? capIds[page.path] : indIds[page.path.split('/')[2]];
---
<PageLayout page={page} banner={isCap || isInd} chips={chipsById[id] ?? []}>
  {id === 'simulation' ? <SimulationPage /> : (isCap || isInd) && <DocPage kind={kind} id={id} />}
</PageLayout>
