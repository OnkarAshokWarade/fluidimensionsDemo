---
import { Icon } from 'astro-icon/components';
import PageLayout from '../layouts/PageLayout.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { contactPage } from '../data/site';
import { contactForms } from '../data/forms';

const icons: Record<string, string> = { business: 'ion:construct-outline', training: 'ion:school-outline', careers: 'ion:people-outline', general: 'ion:chatbubbles-outline' };
const email = import.meta.env.PUBLIC_CONTACT_EMAIL || '';
const info = [
  email
    ? { icon: 'ion:mail-outline', label: 'Email', value: email, note: 'Send us a short description of your challenge.', href: `mailto:${email}` }
    : { icon: 'ion:mail-outline', label: 'Write to us', value: 'Use the form below', note: 'Choose an enquiry type and send a short description.', href: '#enquiry-tabs' },
  { icon: 'ion:chatbubbles-outline', label: 'Engineering Cafe', value: 'Open conversation', note: 'No project brief needed. Share a question or an idea.', href: '/engineering-cafe/' },
  { icon: 'ion:logo-linkedin', label: 'LinkedIn', value: 'Follow FluiDimensions', note: 'News, insights and engineering updates.', href: 'https://www.linkedin.com' },
  { icon: 'ion:shield-checkmark-outline', label: 'Confidentiality', value: 'Handled with care', note: 'Details are used only to respond to your message.', href: '/privacy-policy/' },
];
const steps = [
  ['We read your message', 'An engineer, not a call centre, reviews every enquiry.'],
  ['We reply with questions or next steps', 'Often a short conversation to understand the problem before suggesting an approach.'],
  ['We agree a practical way forward', 'This might be a technical discussion, a proposal or a pointer to the right resource.'],
];
---
<PageLayout page={contactPage} banner badge="Get in touch" lead="Tell us about the problem you are trying to solve. An engineer, not a call centre, reads every message.">
  <!-- 1. Contact information -->
  <section aria-labelledby="reach-heading">
    <p class="font-heading text-xs font-bold uppercase tracking-[0.18em] text-accent">Contact information</p>
    <h2 id="reach-heading" class="mt-2 font-heading text-2xl font-bold text-primary sm:text-3xl">Ways to reach us</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {info.map((item) => (
        <a href={item.href} class="group relative flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-1 hover:border-accent/50 hover:shadow-xl">
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-primary to-secondary text-white shadow-md"><Icon name={item.icon} class="h-6 w-6" aria-hidden="true" /></span>
          <span class="mt-5 font-heading text-xs font-bold uppercase tracking-wider text-slate-500">{item.label}</span>
          <span class="mt-1 break-words font-heading text-lg font-bold text-primary">{item.value}</span>
          <span class="mt-2 font-body text-sm leading-snug text-slate-500">{item.note}</span>
          <Icon name="ion:arrow-forward" class="absolute right-5 top-5 h-4 w-4 text-slate-300 transition group-hover:translate-x-1 group-hover:text-accent" aria-hidden="true" />
        </a>
      ))}
    </div>
  </section>

  <!-- 2. What would you like to do? -->
  <section aria-labelledby="choose-heading" class="mt-16 sm:mt-20">
    <div class="rounded-3xl bg-gradient-to-br from-primary via-[#0B2D5B] to-secondary p-6 sm:p-10">
      <div class="max-w-2xl">
        <p class="font-heading text-xs font-bold uppercase tracking-[0.18em] text-accent">Start here</p>
        <h2 id="choose-heading" class="mt-2 font-heading text-2xl font-bold text-white sm:text-3xl">What would you like to do?</h2>
        <p class="mt-3 font-body text-base leading-7 text-slate-300">Pick the option that fits best so your message reaches the right person.</p>
      </div>
      <div role="tablist" aria-label="Enquiry type" id="enquiry-tabs" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {contactForms.map((form, index) => (
          <a href={`#${form.id}`} role="tab" id={`tab-${form.id}`} aria-controls={form.id} aria-selected={index === 0 ? 'true' : 'false'} class="group relative flex flex-col rounded-2xl border border-white/15 bg-white/[0.07] p-6 text-white backdrop-blur-sm transition hover:-translate-y-1 hover:bg-white/15 aria-selected:border-accent aria-selected:bg-white aria-selected:text-primary aria-selected:shadow-2xl">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent/20 text-accent transition group-aria-selected:bg-accent group-aria-selected:text-white"><Icon name={icons[form.type]} class="h-6 w-6" aria-hidden="true" /></span>
            <span class="mt-5 font-heading text-base font-bold leading-snug">{form.tab}</span>
            <span class="mt-2 font-body text-sm leading-snug text-slate-300 group-aria-selected:text-slate-600">{form.intro}</span>
            <span class="mt-auto inline-flex items-center gap-1.5 pt-5 font-heading text-xs font-semibold uppercase tracking-wider text-accent">Write to us <Icon name="ion:arrow-down" class="h-3.5 w-3.5" aria-hidden="true" /></span>
          </a>
        ))}
      </div>
    </div>

    <div class="mx-auto mt-8 max-w-3xl">
      {contactForms.map((form) => (
        <section id={form.id} role="tabpanel" aria-labelledby={`tab-${form.id}`} data-panel class="scroll-mt-28 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-lg [&:not(:first-child)]:mt-8">
          <div class="flex items-start gap-4 border-b border-slate-200 bg-sky-50 px-6 py-6 sm:px-9">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent text-white"><Icon name={icons[form.type]} class="h-5 w-5" aria-hidden="true" /></span>
            <div>
              <h3 class="font-heading text-xl font-bold text-primary">{form.title}</h3>
              <p class="mt-1 font-body text-sm leading-relaxed text-slate-600">{form.intro}</p>
            </div>
          </div>
          <div class="p-6 sm:p-9">
            <EnquiryForm id={form.id} type={form.type} fields={form.fields} submit={form.submit} successTitle={form.type === 'careers' ? 'Application received' : 'Enquiry received'} />
          </div>
        </section>
      ))}
    </div>
  </section>

  <!-- 3. What happens next -->
  <section aria-labelledby="next-heading" class="mt-16 sm:mt-20">
    <h2 id="next-heading" class="text-center font-heading text-2xl font-bold text-primary sm:text-3xl">What happens next</h2>
    <ol class="relative mt-10 grid gap-8 md:grid-cols-3">
      <div class="pointer-events-none absolute left-[16%] right-[16%] top-6 hidden border-t-2 border-dashed border-slate-300 md:block" aria-hidden="true"></div>
      {steps.map(([title, text], i) => (
        <li class="relative text-center">
          <span class="relative z-10 mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-accent font-heading text-lg font-bold text-white shadow-lg ring-8 ring-white">{i + 1}</span>
          <h3 class="mt-4 font-heading text-base font-bold text-primary">{title}</h3>
          <p class="mx-auto mt-2 max-w-xs font-body text-sm leading-relaxed text-slate-500">{text}</p>
        </li>
      ))}
    </ol>
    <p class="mx-auto mt-12 max-w-3xl rounded-xl bg-amber-50 p-4 text-center font-body text-sm leading-relaxed text-amber-900">We respect confidentiality. Please avoid sharing proprietary documents, sensitive process data or confidential customer information until appropriate confidentiality arrangements are in place.</p>
  </section>
</PageLayout>

<script>
  // Progressive enhancement: without JS every form is shown stacked; with JS only the selected one.
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('#enquiry-tabs [role="tab"]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
  const select = (id: string, updateHash: boolean) => {
    const target = panels.find((panel) => panel.id === id) ?? panels[0];
    panels.forEach((panel) => { panel.hidden = panel !== target; panel.classList.remove('[&:not(:first-child)]:mt-8'); });
    tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.getAttribute('aria-controls') === target.id)));
    if (updateHash) history.replaceState(null, '', `#${target.id}`);
  };
  tabs.forEach((tab) => tab.addEventListener('click', (event) => { event.preventDefault(); select(tab.getAttribute('aria-controls')!, true); }));
  window.addEventListener('hashchange', () => select(location.hash.slice(1), false));
  select(location.hash.slice(1), false);
</script>
