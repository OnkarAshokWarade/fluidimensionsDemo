---
import { Icon } from 'astro-icon/components';
import PageLayout from '../layouts/PageLayout.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { contactPage } from '../data/site';
import { contactForms } from '../data/forms';

const icons: Record<string, string> = { business: 'ion:construct-outline', training: 'ion:school-outline', careers: 'ion:people-outline', general: 'ion:chatbubbles-outline' };
const email = import.meta.env.PUBLIC_CONTACT_EMAIL || '';
const info = [
  email
    ? { icon: 'ion:mail-outline', label: 'Email', value: email, note: 'Send us a short description of your challenge.', href: `mailto:${email}` }
    : { icon: 'ion:mail-outline', label: 'Write to us', value: 'Use the form below', note: 'Choose an enquiry type and send a short description.', href: '#enquiry-tabs' },
  { icon: 'ion:chatbubbles-outline', label: 'Engineering Cafe', value: 'Open conversation', note: 'No project brief needed. Share a question or an idea.', href: '/engineering-cafe/' },
  { icon: 'ion:logo-linkedin', label: 'LinkedIn', value: 'Follow FluiDimensions', note: 'News, insights and engineering updates.', href: 'https://www.linkedin.com' },
  { icon: 'ion:shield-checkmark-outline', label: 'Confidentiality', value: 'Handled with care', note: 'Details are used only to respond to your message.', href: '/privacy-policy/' },
];
const steps = [
  ['We read your message', 'An engineer, not a call centre, reviews every enquiry.'],
  ['We reply with questions or next steps', 'Often a short conversation to understand the problem before suggesting an approach.'],
  ['We agree a practical way forward', 'This might be a technical discussion, a proposal or a pointer to the right resource.'],
];
---
<PageLayout page={contactPage} banner compact badge="Get in touch" lead="Tell us about the problem you are trying to solve. An engineer, not a call centre, reads every message.">
  <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-10">
    <!-- Left: ways to reach us + what happens next -->
    <div class="order-2 space-y-6 lg:sticky lg:top-24 lg:order-1">
      <section aria-labelledby="reach-heading" class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <h2 id="reach-heading" class="font-heading text-lg font-bold text-primary">Ways to reach us</h2>
        <ul class="mt-4 divide-y divide-slate-100">
          {info.map((item) => (
            <li>
              <a href={item.href} class="group flex items-center gap-4 py-3.5 transition first:pt-0 last:pb-0">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-primary to-secondary text-white"><Icon name={item.icon} class="h-5 w-5" aria-hidden="true" /></span>
                <span class="min-w-0 flex-1">
                  <span class="block font-heading text-sm font-bold text-primary group-hover:text-accent">{item.label}: <span class="font-semibold">{item.value}</span></span>
                  <span class="mt-0.5 block font-body text-xs leading-snug text-slate-500">{item.note}</span>
                </span>
                <Icon name="ion:arrow-forward" class="h-4 w-4 shrink-0 text-slate-300 transition group-hover:translate-x-1 group-hover:text-accent" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="next-heading" class="rounded-2xl border border-slate-200 bg-sky-50 p-5 sm:p-6">
        <h2 id="next-heading" class="font-heading text-lg font-bold text-primary">What happens next</h2>
        <ol class="mt-4 space-y-4">
          {steps.map(([title, text], i) => (
            <li class="flex gap-3.5">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent font-heading text-sm font-bold text-white">{i + 1}</span>
              <span><span class="block font-heading text-sm font-bold text-primary">{title}</span><span class="mt-0.5 block font-body text-xs leading-relaxed text-slate-600">{text}</span></span>
            </li>
          ))}
        </ol>
        <p class="mt-5 rounded-lg bg-amber-50 p-3 font-body text-xs leading-relaxed text-amber-900">We respect confidentiality. Please avoid sharing proprietary documents, sensitive process data or confidential customer information until appropriate confidentiality arrangements are in place.</p>
      </section>
    </div>

    <!-- Right: enquiry type tabs + form -->
    <section aria-labelledby="choose-heading" class="order-1 min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-lg lg:order-2">
      <div class="bg-gradient-to-br from-primary via-[#0B2D5B] to-secondary px-5 pb-0 pt-5 sm:px-7 sm:pt-6">
        <h2 id="choose-heading" class="font-heading text-lg font-bold text-white sm:text-xl">What would you like to do?</h2>
        <div role="tablist" aria-label="Enquiry type" id="enquiry-tabs" class="-mx-1 mt-4 flex gap-1 overflow-x-auto px-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          {contactForms.map((form, index) => (
            <a href={`#${form.id}`} role="tab" id={`tab-${form.id}`} aria-controls={form.id} aria-selected={index === 0 ? 'true' : 'false'} class="flex shrink-0 items-center gap-2 rounded-t-xl border border-b-0 border-transparent px-4 py-3 font-heading text-sm font-semibold text-white/80 transition hover:bg-white/10 hover:text-white aria-selected:border-white aria-selected:bg-white aria-selected:text-primary">
              <Icon name={icons[form.type]} class="h-4 w-4" aria-hidden="true" />{form.tab}
            </a>
          ))}
        </div>
      </div>
      {contactForms.map((form) => (
        <section id={form.id} role="tabpanel" aria-labelledby={`tab-${form.id}`} data-panel class="scroll-mt-24 [&:not(:first-of-type)]:border-t [&:not(:first-of-type)]:border-slate-200">
          <div class="border-b border-slate-200 bg-sky-50 px-5 py-4 sm:px-7">
            <h3 class="font-heading text-lg font-bold text-primary">{form.title}</h3>
            <p class="mt-1 font-body text-sm leading-relaxed text-slate-600">{form.intro}</p>
          </div>
          <div class="p-5 sm:p-7">
            <EnquiryForm id={form.id} type={form.type} fields={form.fields} submit={form.submit} successTitle={form.type === 'careers' ? 'Application received' : 'Enquiry received'} />
          </div>
        </section>
      ))}
    </section>
  </div>
</PageLayout>

<script>
  // Progressive enhancement: without JS every form is shown stacked; with JS only the selected one.
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('#enquiry-tabs [role="tab"]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
  const select = (id: string, updateHash: boolean) => {
    const target = panels.find((panel) => panel.id === id) ?? panels[0];
    panels.forEach((panel) => { panel.hidden = panel !== target; });
    tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.getAttribute('aria-controls') === target.id)));
    if (updateHash) history.replaceState(null, '', `#${target.id}`);
  };
  tabs.forEach((tab) => tab.addEventListener('click', (event) => { event.preventDefault(); select(tab.getAttribute('aria-controls')!, true); }));
  window.addEventListener('hashchange', () => select(location.hash.slice(1), false));
  select(location.hash.slice(1), false);
</script>
