---
import PageLayout from '../layouts/PageLayout.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { contactPage } from '../data/site';
import { contactForms } from '../data/forms';
---
<PageLayout page={contactPage}>
  <div class="mt-10 sm:mt-12">
    <p class="mb-4 max-w-3xl font-body text-sm text-slate-600">Choose the kind of enquiry so it reaches the right person.</p>
    <div role="tablist" aria-label="Enquiry type" class="flex flex-wrap gap-2" id="enquiry-tabs">
      {contactForms.map((form, index) => (
        <a href={`#${form.id}`} role="tab" id={`tab-${form.id}`} aria-controls={form.id} aria-selected={index === 0 ? 'true' : 'false'} class="min-h-11 rounded-full border border-slate-300 bg-white px-5 py-2.5 font-heading text-sm font-semibold text-slate-700 transition hover:border-accent hover:text-accent aria-selected:border-accent aria-selected:bg-accent aria-selected:text-white">{form.tab}</a>
      ))}
    </div>

    <div class="mt-8 max-w-3xl">
      {contactForms.map((form, index) => (
        <section id={form.id} role="tabpanel" aria-labelledby={`tab-${form.id}`} data-panel class="scroll-mt-28 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 [&:not(:first-child)]:mt-8" hidden={false}>
          <h2 class="font-heading text-xl font-bold text-primary sm:text-2xl">{form.title}</h2>
          <p class="mt-2 mb-6 font-body text-sm leading-relaxed text-slate-600">{form.intro}</p>
          <EnquiryForm id={form.id} type={form.type} fields={form.fields} submit={form.submit} successTitle={form.type === 'careers' ? 'Application received' : 'Enquiry received'} />
        </section>
      ))}
    </div>
  </div>
</PageLayout>

<script>
  // Progressive enhancement: without JS every form is shown stacked; with JS only the selected one.
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('#enquiry-tabs [role="tab"]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
  const select = (id: string, updateHash: boolean) => {
    const target = panels.find((panel) => panel.id === id) ?? panels[0];
    panels.forEach((panel) => { panel.hidden = panel !== target; panel.classList.remove('[&:not(:first-child)]:mt-8'); });
    tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.getAttribute('aria-controls') === target.id)));
    if (updateHash) history.replaceState(null, '', `#${target.id}`);
  };
  tabs.forEach((tab) => tab.addEventListener('click', (event) => { event.preventDefault(); select(tab.getAttribute('aria-controls')!, true); }));
  window.addEventListener('hashchange', () => select(location.hash.slice(1), false));
  select(location.hash.slice(1), false);
</script>
