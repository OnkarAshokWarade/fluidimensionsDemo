---
import PageLayout from '../layouts/PageLayout.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { cafePage } from '../data/site';
import { cafeForm } from '../data/forms';
import { getPosts, formatDate } from '../lib/sanity';

const posts = (await getPosts()).slice(0, 3);
const topics = [
  'A process challenge you are working through',
  'A modelling or simulation approach you are considering',
  'An idea you would like a second opinion on',
  'An engineering topic you are simply curious about',
];
---
<PageLayout page={cafePage}>
  <section aria-labelledby="bring-heading" class="mt-14 sm:mt-16">
    <h2 id="bring-heading" class="font-heading text-xl font-bold text-primary sm:text-2xl">What you can bring</h2>
    <ul class="mt-5 max-w-3xl list-disc space-y-2 pl-5 font-body text-base leading-relaxed text-slate-600 marker:text-accent">
      {topics.map((topic) => <li>{topic}</li>)}
    </ul>
    <p class="mt-4 max-w-3xl font-body text-sm text-slate-500">This is an open conversation, not a formal sales enquiry. For a project enquiry, use the <a href="/contact/#business-enquiries" class="text-secondary underline underline-offset-2 hover:text-accent">contact page</a>.</p>
  </section>

  <section aria-labelledby="start-heading" class="mt-14 max-w-3xl rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:mt-16 sm:p-8">
    <h2 id="start-heading" class="font-heading text-xl font-bold text-primary sm:text-2xl">{cafeForm.title}</h2>
    <p class="mt-2 mb-6 font-body text-sm leading-relaxed text-slate-600">{cafeForm.intro}</p>
    <EnquiryForm id={cafeForm.id} type={cafeForm.type} fields={cafeForm.fields} submit={cafeForm.submit} successTitle="Thanks for sharing" successText="We have received your message and will join the conversation." />
  </section>

  {posts.length > 0 && (
    <section aria-labelledby="latest-heading" class="mt-14 sm:mt-16">
      <h2 id="latest-heading" class="font-heading text-xl font-bold text-primary sm:text-2xl">Latest articles</h2>
      <ul class="mt-5 grid gap-4 sm:grid-cols-3">
        {posts.map((post) => (
          <li><a href={`/blog/${post.slug}/`} class="block h-full rounded-xl border border-slate-200 bg-white p-5 transition hover:border-accent/40"><time datetime={post.publishedAt} class="text-xs font-semibold uppercase tracking-wider text-accent">{formatDate(post.publishedAt)}</time><span class="mt-1 block font-heading text-sm font-bold text-primary">{post.title}</span></a></li>
        ))}
      </ul>
      <a href="/blog/" class="mt-5 inline-block font-heading text-sm font-semibold text-secondary hover:text-accent">All articles →</a>
    </section>
  )}
</PageLayout>
