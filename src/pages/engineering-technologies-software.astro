---
import { Icon } from 'astro-icon/components';
import PageLayout from '../layouts/PageLayout.astro';
import { technologiesPage } from '../data/site';
import { technologiesSection } from '../data/home';

// DRAFT copy from the blueprint. Platform names (e.g. Siemens products) stay out until the
// partner scope is confirmed; see docs/content-review-checklist.md.
const support = [
  { title: 'Software-related consultation', text: 'Help evaluating which tools suit a particular engineering problem.' },
  { title: 'Training', text: 'Technical training on engineering software and methods.' },
  { title: 'Proof-of-concept studies', text: 'Small, focused studies that test an approach before wider commitment.' },
  { title: 'Application support', text: 'Support applying tools to your real engineering cases.' },
  { title: 'Integration', text: 'Connecting tools and models into your engineering workflows.' },
];
---
<PageLayout page={technologiesPage}>
  <section aria-labelledby="areas-heading" class="mt-14 sm:mt-16">
    <h2 id="areas-heading" class="font-heading text-xl font-bold text-primary sm:text-2xl">Technology areas</h2>
    <p class="mt-5 max-w-3xl font-body text-base leading-relaxed text-slate-600">{technologiesSection.body[0]}</p>
    <ul class="mt-6 flex flex-wrap gap-3" aria-label="Technology areas">
      {technologiesSection.areas.map((area) => <li class="rounded-full border border-slate-200 bg-white px-5 py-3 font-heading text-sm font-semibold text-secondary">{area}</li>)}
    </ul>
  </section>

  <section aria-labelledby="support-heading" class="mt-14 sm:mt-16">
    <h2 id="support-heading" class="font-heading text-xl font-bold text-primary sm:text-2xl">How we can support you</h2>
    <p class="mt-5 max-w-3xl font-body text-base leading-relaxed text-slate-600">{technologiesSection.body[1]}</p>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {support.map((item) => (
        <li class="rounded-2xl border border-slate-200 bg-white p-6"><h3 class="font-heading text-base font-bold text-primary">{item.title}</h3><p class="mt-2 font-body text-sm leading-relaxed text-slate-600">{item.text}</p></li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="platforms-heading" class="mt-14 sm:mt-16">
    <h2 id="platforms-heading" class="font-heading text-xl font-bold text-primary sm:text-2xl">Platforms</h2>
    <p class="mt-5 max-w-3xl rounded-xl border border-dashed border-slate-300 bg-white p-5 font-body text-sm leading-relaxed text-slate-500">Details of specific software platforms, and our role with each, will be published here once confirmed.</p>
  </section>

  <div class="mt-16 flex flex-wrap gap-4">
    <a href="/contact/#training-enquiries" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-accent px-6 font-heading text-sm font-semibold text-white shadow-lg shadow-accent/20 transition hover:-translate-y-0.5 hover:bg-accent-dark">Ask about software or training <Icon name="ion:arrow-forward" class="h-4 w-4" aria-hidden="true" /></a>
  </div>
</PageLayout>
