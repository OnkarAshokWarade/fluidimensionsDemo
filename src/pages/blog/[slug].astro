---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
import { getPosts, getPost, renderBody, urlFor, formatDate } from '../../lib/sanity';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const post = await getPost(Astro.params.slug!);
if (!post) return Astro.redirect('/404/');

const path = `/blog/${post.slug}/`;
const title = `${post.title} | ${SITE.name}`;
const image = post.mainImage?.asset ? urlFor(post.mainImage).width(1200).height(630).fit('crop').auto('format').url() : undefined;
const html = post.html ?? renderBody(post.body);
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.publishedAt,
  dateModified: post._updatedAt,
  mainEntityOfPage: `${SITE.url}${path}`,
  ...(image && { image }),
  author: { '@type': post.author ? 'Person' : 'Organization', name: post.author || SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: `${SITE.url}/logo.png` } },
}];
---
<BaseLayout {title} description={post.excerpt} {path} ogType="article" noindex={Boolean(post.sample)} {image} {jsonLd}>
  <main class="pb-20 pt-28 sm:pt-32">
    <article class="site-container max-w-3xl">
      <nav aria-label="Breadcrumb" class="mb-6 text-xs font-medium text-slate-500">
        <ol class="flex flex-wrap items-center gap-2"><li><a href="/" class="hover:text-accent">Home</a></li><li aria-hidden="true">/</li><li><a href="/blog/" class="hover:text-accent">Blog</a></li><li aria-hidden="true">/</li><li aria-current="page" class="text-primary">{post.title}</li></ol>
      </nav>
      <header>
        <time datetime={post.publishedAt} class="font-body text-sm font-semibold uppercase tracking-wider text-accent">{formatDate(post.publishedAt)}</time>
        <h1 class="mt-3 font-heading text-[clamp(1.875rem,5vw,3rem)] font-black leading-tight text-primary">{post.title}</h1>
        {post.sample && <p class="mt-3 inline-block rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-900">Sample article, shown until real posts are published</p>}
        {post.author && <p class="mt-3 font-body text-sm text-slate-500">By {post.author}</p>}
      </header>
      {image && <img src={image} alt={post.mainImage?.alt || ''} width="1200" height="630" class="mt-8 aspect-[1200/630] w-full rounded-2xl object-cover" />}
      <div class="post-body mt-10" set:html={html} />
      <footer class="mt-14 border-t border-slate-200 pt-8">
        <a href="/blog/" class="font-heading text-sm font-semibold text-secondary hover:text-accent">← All articles</a>
      </footer>
    </article>
  </main>
</BaseLayout>
