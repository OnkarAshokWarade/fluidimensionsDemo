---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, CONTACT_BUSINESS } from '../../data/site';
import { getPosts, getPost, renderBody, urlFor, formatDate } from '../../lib/sanity';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const post = await getPost(Astro.params.slug!);
if (!post) return Astro.redirect('/404/');

const path = `/blog/${post.slug}/`;
const title = `${post.title} | ${SITE.name}`;
const image = post.mainImage?.asset ? urlFor(post.mainImage).width(1200).height(630).fit('crop').auto('format').url() : undefined;
const rawHtml = post.html ?? renderBody(post.body);

// Give every H2 an id so the "In this article" menu can link to it.
const slugify = (text: string) => text.toLowerCase().replace(/<[^>]+>/g, '').replace(/&[a-z]+;/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const headings: { id: string; text: string }[] = [];
const html = rawHtml.replace(/<h2>([\s\S]*?)<\/h2>/g, (_m, inner: string) => {
  const text = inner.replace(/<[^>]+>/g, '');
  const id = slugify(inner) || `section-${headings.length + 1}`;
  headings.push({ id, text });
  return `<h2 id="${id}">${inner}</h2>`;
});
const words = rawHtml.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const readMins = post.readMins ?? Math.max(1, Math.round(words / 200));

const related = (await getPosts()).filter((p) => p.slug !== post.slug).slice(0, 3);
const shareUrl = encodeURIComponent(`${SITE.url}${path}`);
const shareTitle = encodeURIComponent(post.title);

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.publishedAt,
  dateModified: post._updatedAt,
  mainEntityOfPage: `${SITE.url}${path}`,
  ...(image && { image }),
  author: { '@type': post.author ? 'Person' : 'Organization', name: post.author || SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: `${SITE.url}/logo.png` } },
}];
---
<BaseLayout {title} description={post.excerpt} {path} ogType="article" noindex={Boolean(post.sample)} {image} {jsonLd}>
  <main>
    <!-- Article header -->
    <header class="relative overflow-hidden bg-gradient-to-br from-primary via-[#0B2D5B] to-secondary pb-12 pt-28 text-white sm:pb-16 sm:pt-36">
      <div class="cfd-grid pointer-events-none absolute inset-0 opacity-10" aria-hidden="true"></div>
      <div class="site-container relative max-w-4xl">
        <nav aria-label="Breadcrumb" class="mb-6 text-sm text-slate-300">
          <ol class="flex flex-wrap items-center gap-2"><li><a href="/" class="hover:text-white">Home</a></li><li aria-hidden="true">/</li><li><a href="/blog/" class="hover:text-white">Blog</a></li><li aria-hidden="true">/</li><li aria-current="page" class="font-semibold text-white">Article</li></ol>
        </nav>
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-full bg-accent px-3 py-1 text-xs font-bold uppercase tracking-widest text-white">{post.category ?? 'Article'}</span>
          {post.sample && <span class="rounded-full border border-white/30 bg-white/10 px-3 py-1 text-xs font-semibold text-white">Sample article</span>}
        </div>
        <h1 class="mt-4 font-heading text-[clamp(1.875rem,4.6vw,3rem)] font-bold leading-[1.15] text-white">{post.title}</h1>
        <p class="mt-4 max-w-3xl font-body text-lg leading-8 text-slate-200">{post.excerpt}</p>
        <ul class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 font-body text-sm text-slate-300">
          <li class="flex items-center gap-2"><Icon name="ion:person-outline" class="h-4 w-4" aria-hidden="true" />{post.author || SITE.name}</li>
          <li class="flex items-center gap-2"><Icon name="ion:calendar-outline" class="h-4 w-4" aria-hidden="true" /><time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time></li>
          <li class="flex items-center gap-2"><Icon name="ion:time-outline" class="h-4 w-4" aria-hidden="true" />{readMins} min read</li>
        </ul>
      </div>
    </header>

    <div class="site-container py-12 sm:py-16">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-14">
        <article class="min-w-0">
          {image && <img src={image} alt={post.mainImage?.alt || ''} width="1200" height="630" class="mb-10 aspect-[1200/630] w-full rounded-2xl border border-slate-200 object-cover" />}
          <div class="post-body max-w-3xl" set:html={html} />

          <div class="mt-12 flex flex-wrap items-center gap-3 border-t border-slate-200 pt-6">
            <span class="font-heading text-sm font-bold text-primary">Share</span>
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-10 items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 hover:border-accent hover:text-accent"><Icon name="ion:logo-linkedin" class="h-4 w-4" aria-hidden="true" />LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
            <a href={`mailto:?subject=${shareTitle}&body=${shareUrl}`} class="inline-flex min-h-10 items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 hover:border-accent hover:text-accent"><Icon name="ion:mail-outline" class="h-4 w-4" aria-hidden="true" />Email</a>
          </div>
        </article>

        <aside class="space-y-5 lg:sticky lg:top-28 lg:self-start" aria-label="Article sidebar">
          {headings.length > 1 && (
            <nav aria-label="In this article" class="rounded-2xl border border-sky-200 bg-sky-50 p-5">
              <p class="text-xs font-bold uppercase tracking-widest text-secondary">In this article</p>
              <ul class="mt-3 space-y-2">
                {headings.map((h) => <li><a href={`#${h.id}`} class="flex items-start gap-2 font-body text-sm font-semibold text-primary hover:text-accent"><Icon name="ion:chevron-forward" class="mt-0.5 h-4 w-4 shrink-0 text-accent" aria-hidden="true" />{h.text}</a></li>)}
              </ul>
            </nav>
          )}
          <div class="rounded-2xl bg-primary p-5 text-white">
            <p class="font-heading text-base font-bold">Have an engineering question?</p>
            <p class="mt-2 font-body text-sm leading-relaxed text-slate-300">Talk to our team about your process, equipment or modelling challenge.</p>
            <a href={CONTACT_BUSINESS} class="mt-4 inline-flex min-h-10 items-center rounded-lg bg-accent px-4 font-heading text-sm font-semibold text-white hover:bg-accent-dark">Start a conversation</a>
          </div>
        </aside>
      </div>

      {related.length > 0 && (
        <section class="mt-16 border-t border-slate-200 pt-12" aria-labelledby="related-title">
          <h2 id="related-title" class="font-heading text-2xl font-bold text-primary">Keep reading</h2>
          <ul class="mt-6 grid gap-5 md:grid-cols-3">
            {related.map((r) => (
              <li>
                <a href={`/blog/${r.slug}/`} class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
                  <span class="w-fit rounded-full bg-sky-50 px-2.5 py-0.5 text-xs font-bold uppercase tracking-wider text-secondary">{r.category ?? 'Article'}</span>
                  <h3 class="mt-3 font-heading text-base font-bold text-primary group-hover:text-accent">{r.title}</h3>
                  <p class="mt-2 flex-1 font-body text-sm leading-relaxed text-slate-600">{r.excerpt}</p>
                  <span class="mt-4 inline-flex items-center gap-1 font-heading text-sm font-bold text-secondary group-hover:text-accent">Read article <Icon name="ion:arrow-forward" class="h-4 w-4" aria-hidden="true" /></span>
                </a>
              </li>
            ))}
          </ul>
          <a href="/blog/" class="mt-6 inline-flex items-center gap-1 font-heading text-sm font-semibold text-secondary hover:text-accent"><Icon name="ion:arrow-back" class="h-4 w-4" aria-hidden="true" />All articles</a>
        </section>
      )}
    </div>
  </main>
</BaseLayout>
