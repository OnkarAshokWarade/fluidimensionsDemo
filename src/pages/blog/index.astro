---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
import { getPosts, urlFor, formatDate } from '../../lib/sanity';

const posts = await getPosts();
const title = `Blog: Engineering Insights | ${SITE.name}`;
const description = 'Articles on engineering simulation, process modelling, equipment design and technology from the FluiDimensions team.';
---
<BaseLayout {title} {description} path="/blog/">
  <main class="pb-20 pt-28 sm:pt-32">
    <div class="site-container">
      <nav aria-label="Breadcrumb" class="mb-6 text-xs font-medium text-slate-500">
        <ol class="flex items-center gap-2"><li><a href="/" class="hover:text-accent">Home</a></li><li aria-hidden="true">/</li><li aria-current="page" class="text-primary">Blog</li></ol>
      </nav>
      <header class="max-w-3xl">
        <h1 class="font-heading text-[clamp(2rem,6vw,3.25rem)] font-black leading-tight text-primary">Engineering Insights</h1>
        <p class="mt-5 font-body text-base leading-relaxed text-slate-600 sm:text-lg">{description}</p>
      </header>

      {posts.length === 0 ? (
        <p class="mt-12 max-w-3xl rounded-xl border border-dashed border-slate-300 bg-white p-6 font-body text-sm text-slate-500">Articles are coming soon.</p>
      ) : (
        <>
          <!-- Featured (latest) article -->
          <a href={`/blog/${posts[0].slug}/`} class="group mt-10 grid overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition hover:shadow-xl lg:grid-cols-2">
            {posts[0].mainImage?.asset ? (
              <img src={urlFor(posts[0].mainImage).width(1000).height(600).fit('crop').auto('format').url()} alt={posts[0].mainImage.alt || ''} width="1000" height="600" decoding="async" class="h-full min-h-56 w-full object-cover" />
            ) : (
              <div class="flex min-h-56 items-center justify-between bg-gradient-to-br from-primary to-secondary p-8">
                <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-bold uppercase tracking-widest text-white">{posts[0].category ?? 'Article'}</span>
                {posts[0].icon && <Icon name={posts[0].icon} class="h-20 w-20 text-white/80" aria-hidden="true" />}
              </div>
            )}
            <div class="flex flex-col justify-center p-6 sm:p-10">
              <p class="flex flex-wrap items-center gap-2 font-body text-xs font-semibold uppercase tracking-wider text-accent"><span class="rounded-full bg-accent px-2.5 py-0.5 text-white">Latest</span><time datetime={posts[0].publishedAt}>{formatDate(posts[0].publishedAt)}</time>{posts[0].readMins && <span class="text-slate-500">· {posts[0].readMins} min read</span>}</p>
              <h2 class="mt-3 font-heading text-2xl font-bold leading-tight text-primary group-hover:text-accent sm:text-3xl">{posts[0].title}</h2>
              <p class="mt-3 font-body text-base leading-relaxed text-slate-600">{posts[0].excerpt}</p>
              <span class="mt-5 inline-flex items-center gap-1 font-heading text-sm font-bold text-secondary group-hover:text-accent">Read article <Icon name="ion:arrow-forward" class="h-4 w-4" aria-hidden="true" /></span>
            </div>
          </a>

          {posts.length > 1 && (
            <>
              <h2 class="mt-14 font-heading text-xl font-bold text-primary sm:text-2xl">More articles</h2>
              <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {posts.slice(1).map((post) => (
                  <li>
                    <a href={`/blog/${post.slug}/`} class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
                      {post.mainImage?.asset ? (
                        <img src={urlFor(post.mainImage).width(800).height(450).fit('crop').auto('format').url()} alt={post.mainImage.alt || ''} width="800" height="450" loading="lazy" decoding="async" class="aspect-video w-full object-cover" />
                      ) : (
                        <div class="flex aspect-video w-full items-center justify-between bg-gradient-to-br from-primary to-secondary p-5">
                          <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-bold uppercase tracking-widest text-white">{post.category ?? 'Article'}</span>
                          {post.icon && <Icon name={post.icon} class="h-12 w-12 text-white/80" aria-hidden="true" />}
                        </div>
                      )}
                      <div class="flex flex-1 flex-col p-6">
                        <p class="flex items-center gap-2 font-body text-xs font-semibold uppercase tracking-wider text-accent"><time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>{post.readMins && <span class="text-slate-500">· {post.readMins} min read</span>}</p>
                        <h3 class="mt-2 font-heading text-lg font-bold text-primary group-hover:text-accent">{post.title}</h3>
                        <p class="mt-2 flex-1 font-body text-sm leading-relaxed text-slate-600">{post.excerpt}</p>
                        <span class="mt-4 inline-flex items-center gap-1 font-heading text-sm font-bold text-secondary group-hover:text-accent">Read article <Icon name="ion:arrow-forward" class="h-4 w-4" aria-hidden="true" /></span>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}
        </>
      )}
    </div>
  </main>
</BaseLayout>
