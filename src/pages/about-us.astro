---
import { Icon } from 'astro-icon/components';
import PageLayout from '../layouts/PageLayout.astro';
import Cta from '../components/pages/Cta.astro';
import ReactorViz from '../components/ReactorViz.astro';
import { aboutPage, industryPages } from '../data/site';
import { APPROACH, VALUES, CAPS } from '../data/doc';
import { visionSection } from '../data/home';

const capLink: Record<string, string> = { simulation: '/engineering-simulation/', process: '/chemical-engineering-process-consulting/', design: '/engineering-design/', ml: '/machine-learning-data-intelligence/', software: '/software-automation/' };
const tones = [
  { chip: 'bg-sky-100 text-sky-900 border-sky-200', num: 'bg-sky-600', head: 'bg-sky-50', border: 'border-sky-200', bar: 'border-t-sky-500', text: 'text-sky-700' },
  { chip: 'bg-emerald-100 text-emerald-900 border-emerald-200', num: 'bg-emerald-600', head: 'bg-emerald-50', border: 'border-emerald-200', bar: 'border-t-emerald-500', text: 'text-emerald-700' },
  { chip: 'bg-violet-100 text-violet-900 border-violet-200', num: 'bg-violet-600', head: 'bg-violet-50', border: 'border-violet-200', bar: 'border-t-violet-500', text: 'text-violet-700' },
  { chip: 'bg-amber-100 text-amber-900 border-amber-200', num: 'bg-amber-600', head: 'bg-amber-50', border: 'border-amber-200', bar: 'border-t-amber-500', text: 'text-amber-700' },
  { chip: 'bg-rose-100 text-rose-900 border-rose-200', num: 'bg-rose-600', head: 'bg-rose-50', border: 'border-rose-200', bar: 'border-t-rose-500', text: 'text-rose-700' },
  { chip: 'bg-cyan-100 text-cyan-900 border-cyan-200', num: 'bg-cyan-600', head: 'bg-cyan-50', border: 'border-cyan-200', bar: 'border-t-cyan-500', text: 'text-cyan-700' },
];
const t = (i: number) => tones[i % tones.length];
const capabilityCards = CAPS.filter((c) => c.t !== 'Digital Engineering');
const icons: Record<string, string> = { simulation: 'ion:analytics-outline', process: 'ion:flask-outline', design: 'ion:construct-outline', ml: 'ion:git-network-outline', software: 'ion:hardware-chip-outline' };
const valueIcons = ['ion:heart-outline', 'ion:shield-checkmark-outline', 'ion:ribbon-outline'];
const facts = [
  ['ion:flask-outline', 'Chemical engineering', 'The foundation behind every capability'],
  ['ion:layers-outline', `${capabilityCards.length} capability areas`, 'Used together, not in isolation'],
  ['ion:business-outline', `${industryPages.length} industries`, 'Process and manufacturing sectors'],
  ['ion:time-outline', '25+ years', 'Technical leadership experience'],
];
const credentials = ['Ph.D. in chemical engineering', 'Postdoctoral research experience', 'Over 25 years across industry, R&D and technology development', 'Senior technical and managerial roles at UOP India', 'Senior roles at Aditya Birla Science and Technology Centre', 'Research collaborations, academic engagement and consultancy'];
const eyebrow = 'text-sm font-bold uppercase tracking-widest text-accent';
const h2 = 'font-heading text-2xl font-bold text-primary sm:text-3xl';
---
<PageLayout page={aboutPage} banner badge="About us" chips={['Chemical engineering', 'Modelling & simulation', 'Machine learning', 'Digital technologies', 'Process consulting']} lead="We bring together engineering expertise, advanced modelling and simulation, machine learning and digital technologies to solve complex technical challenges and develop practical engineering solutions.">
  <ReactorViz slot="aside" />
  <!-- Fact tiles -->
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {facts.map(([icon, title, sub], i) => (
      <li class={`flex items-center gap-4 rounded-2xl border bg-white p-5 shadow-sm ${t(i).border}`}>
        <span class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-xl text-white ${t(i).num}`}><Icon name={icon} class="h-6 w-6" aria-hidden="true" /></span>
        <span><span class="block font-heading text-lg font-bold leading-tight text-primary">{title}</span><span class="block font-body text-sm text-slate-600">{sub}</span></span>
      </li>
    ))}
  </ul>

  <!-- Vision -->
  <section class="mt-16 overflow-hidden rounded-3xl bg-primary px-6 py-12 text-white sm:px-12 sm:py-16">
    <p class="text-sm font-bold uppercase tracking-widest text-accent">Our vision</p>
    <h2 class="mt-3 max-w-4xl font-heading text-[clamp(1.6rem,3.6vw,2.6rem)] font-bold leading-tight">To be the engineering solutions partner of choice.</h2>
    <p class="mt-5 max-w-3xl font-body text-base leading-8 text-slate-300 sm:text-lg">{visionSection.vision}</p>
    <p class="mt-4 max-w-3xl font-body text-base leading-8 text-slate-300">We want to become a trusted partner for organisations that look to innovate, improve the way they operate and achieve lasting performance improvements.</p>
  </section>

  <!-- Who we are + approach -->
  <section class="mt-20">
    <p class={eyebrow}>Who we are</p>
    <h2 class={`${h2} mt-2 max-w-3xl`}>A multidisciplinary engineering company</h2>
    <div class="mt-5 grid gap-8 lg:grid-cols-2">
      <p class="font-body text-base leading-relaxed text-slate-700">FluiDimensions is an engineering solutions company with a strong foundation in chemical engineering, computational modelling, process engineering and technology development.</p>
      <p class="font-body text-base leading-relaxed text-slate-700">We place particular emphasis on technically challenging problems that need deeper engineering understanding, rather than standard tools or routine analysis.</p>
    </div>
    <h3 class="mt-12 font-heading text-lg font-bold text-primary">How we approach an engineering challenge</h3>
    <ol class="relative mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {APPROACH.map(([title, text], i) => (
        <li class={`relative rounded-2xl border border-t-4 bg-white p-6 shadow-sm ${t(i).border} ${t(i).bar}`}>
          <span class={`flex h-10 w-10 items-center justify-center rounded-full font-heading text-sm font-bold text-white ${t(i).num}`}>{i + 1}</span>
          <h4 class="mt-4 font-heading text-base font-bold text-primary">{title}</h4>
          <p class="mt-2 font-body text-sm leading-relaxed text-slate-600">{text}</p>
        </li>
      ))}
    </ol>
    <p class="mt-5 text-sm text-slate-600">We stay engaged throughout: from understanding the initial challenge to explaining the results and supporting informed engineering decisions.</p>
  </section>

  <!-- Capabilities -->
  <section class="mt-20 rounded-3xl bg-sky-100 px-6 py-12 sm:px-10">
    <p class={eyebrow}>Capabilities</p>
    <h2 class={`${h2} mt-2`}>What we bring together</h2>
    <p class="mt-4 max-w-3xl font-body text-base leading-relaxed text-slate-700">Our capabilities are not isolated service offerings. We combine them as appropriate to develop solutions that address the engineering problem as a whole.</p>
    <ul class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {capabilityCards.map((c, i) => (
        <li><a href={capLink[c.id]} class={`group flex h-full flex-col rounded-2xl border border-t-4 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg ${t(i).border} ${t(i).bar}`}>
          <span class={`flex h-11 w-11 items-center justify-center rounded-xl text-white ${t(i).num}`}><Icon name={icons[c.id]} class="h-6 w-6" aria-hidden="true" /></span>
          <h3 class="mt-4 font-heading text-base font-bold text-primary group-hover:text-accent">{c.t}</h3>
          <p class="mt-2 flex-1 font-body text-sm leading-relaxed text-slate-600">{c.d}</p>
          <span class="mt-4 inline-flex items-center gap-1 font-heading text-xs font-bold text-secondary">Explore <Icon name="ion:arrow-forward" class="h-4 w-4" aria-hidden="true" /></span>
        </a></li>
      ))}
    </ul>
    <p class="mt-10 font-heading text-sm font-bold uppercase tracking-widest text-secondary">Industries we serve</p>
    <ul class="mt-3 flex flex-wrap gap-2.5">{industryPages.map((p, i) => <li><a href={p.path} class={`rounded-full border px-4 py-2 font-heading text-sm font-semibold transition hover:shadow-md ${t(i).chip}`}>{p.label}</a></li>)}</ul>
  </section>

  <!-- Philosophy -->
  <section class="mt-20">
    <p class={eyebrow}>Our philosophy</p>
    <h2 class={`${h2} mt-2 max-w-3xl`}>Technology answers the right question</h2>
    <p class="mt-4 max-w-3xl font-body text-base leading-relaxed text-slate-700">Advanced technology is valuable only when it helps answer the right engineering question. A sophisticated simulation, a predictive model or a customised software tool is not an end in itself. Its value lies in the understanding it creates, the decisions it supports and the improvements it enables.</p>
    <ul class="mt-8 grid gap-5 md:grid-cols-3">
      {[['Understand the problem', 'Start with the real engineering question, not the tool.'], ['Apply the right engineering', 'Combine fundamental knowledge with appropriate analytical and digital tools.'], ['Deliver a practical solution', 'Translate insight into decisions, designs, models and tools you can use.']].map(([title, text], i) => (
        <li class={`rounded-2xl border p-6 ${t(i).head} ${t(i).border}`}><p class={`font-heading text-3xl font-bold ${t(i).text}`}>{i + 1}</p><h3 class="mt-2 font-heading text-lg font-bold text-primary">{title}</h3><p class="mt-2 font-body text-sm leading-relaxed text-slate-700">{text}</p></li>
      ))}
    </ul>
  </section>

  <!-- Values -->
  <section class="mt-20">
    <p class={eyebrow}>Our values</p>
    <h2 class={`${h2} mt-2`}>Passion. Integrity. Commitment.</h2>
    <p class="mt-4 max-w-3xl font-body text-base leading-relaxed text-slate-700">For us, engineering is more than a profession. We find satisfaction in understanding difficult problems and developing solutions that make a meaningful difference. Trust, honesty and a strong sense of responsibility matter as much as technical expertise.</p>
    <ul class="mt-8 grid gap-5 md:grid-cols-3">
      {VALUES.map(([title, subtitle, text], i) => (
        <li class={`overflow-hidden rounded-2xl border bg-white shadow-sm ${t(i + 1).border}`}>
          <div class={`flex items-center gap-3 border-b px-6 py-4 ${t(i + 1).head} ${t(i + 1).border}`}><span class={`flex h-11 w-11 items-center justify-center rounded-xl text-white ${t(i + 1).num}`}><Icon name={valueIcons[i]} class="h-6 w-6" aria-hidden="true" /></span><span class="font-heading text-lg font-bold text-primary">{title}</span></div>
          <div class="p-6"><h3 class="font-heading text-base font-bold text-primary">{subtitle}</h3><p class="mt-2 font-body text-sm leading-relaxed text-slate-600">{text}</p></div>
        </li>
      ))}
    </ul>
  </section>

  <!-- Leadership -->
  <section class="mt-20 grid items-start gap-8 lg:grid-cols-[1.1fr_0.9fr]">
    <div>
      <p class={eyebrow}>Technical leadership</p>
      <h2 class={`${h2} mt-2`}>Research depth and industrial experience</h2>
      <div class="mt-5 space-y-4 font-body text-base leading-relaxed text-slate-700">
        <p>FluiDimensions is led by a chemical engineering professional with a Ph.D. and postdoctoral research experience, and over 25 years of experience across industrial engineering, research and development, and technology development.</p>
        <p>The technical leadership brings extensive experience in computational fluid dynamics, multiphase systems, combustion, process engineering, equipment design and machine learning applications. This combination of research depth and industrial experience shapes our approach: scientific understanding, engineering judgement and practical problem-solving.</p>
      </div>
    </div>
    <div class="rounded-2xl border border-slate-300 bg-white p-6 shadow-sm sm:p-8">
      <p class="font-heading text-sm font-bold uppercase tracking-widest text-secondary">Background at a glance</p>
      <ul class="mt-5 space-y-3">{credentials.map((c, i) => <li class="flex gap-3 font-body text-sm text-slate-700"><Icon name="ion:checkmark-circle" class={`mt-0.5 h-5 w-5 shrink-0 ${t(i).text}`} aria-hidden="true" />{c}</li>)}</ul>
    </div>
  </section>

  <!-- Partnerships -->
  <section class="mt-20 rounded-3xl border border-slate-300 bg-white p-6 shadow-sm sm:p-10">
    <div class="grid items-center gap-8 lg:grid-cols-[1.2fr_0.8fr]">
      <div>
        <p class={eyebrow}>Long-term partnerships</p>
        <h2 class={`${h2} mt-2`}>More than a provider of individual services</h2>
        <p class="mt-4 font-body text-base leading-relaxed text-slate-700">We aspire to be a trusted engineering solutions partner that customers turn to when they meet challenging technical problems, want to improve performance or explore new engineering possibilities. We value relationships built on technical trust, open communication and a shared commitment to meaningful results.</p>
      </div>
      <div class="rounded-2xl bg-sky-50 p-6 text-center">
        <Icon name="ion:link-outline" class="mx-auto h-9 w-9 text-secondary" aria-hidden="true" />
        <p class="mt-3 font-heading text-lg font-bold text-primary">Siemens software channel partner</p>
        <p class="mt-1 font-body text-sm text-slate-600">Engineering software, training and proof-of-concept support.</p>
        <a href="/engineering-technologies-software/" class="mt-4 inline-flex items-center gap-1 font-heading text-sm font-bold text-secondary hover:text-accent">Technologies &amp; Software <Icon name="ion:arrow-forward" class="h-4 w-4" aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <Cta heading="Let’s talk about your engineering challenge" text="FluiDimensions: engineering expertise, practical solutions, lasting performance." />
</PageLayout>
