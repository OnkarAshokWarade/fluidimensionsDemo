---
import { Icon } from 'astro-icon/components';
import PageLayout from '../layouts/PageLayout.astro';
import Cta from '../components/pages/Cta.astro';
import { aboutPage, industryPages } from '../data/site';
import { APPROACH, VALUES, CAPS } from '../data/doc';
import { visionSection } from '../data/home';

const h2 = 'font-heading text-2xl font-bold text-primary sm:text-3xl';
const eyebrow = 'text-sm font-bold uppercase tracking-widest text-accent';
const capLink: Record<string, string> = { simulation: '/engineering-simulation/', process: '/chemical-engineering-process-consulting/', design: '/engineering-design/', ml: '/machine-learning-data-intelligence/', software: '/software-automation/' };
---
<PageLayout page={aboutPage} lead="We bring together engineering expertise, advanced modelling and simulation, machine learning and digital technologies to solve complex technical challenges and develop practical engineering solutions.">
  <section class="grid items-start gap-10 lg:grid-cols-2 lg:gap-16">
    <div>
      <p class={eyebrow}>Vision</p>
      <h2 class={`${h2} mt-2`}>The engineering solutions partner of choice</h2>
    </div>
    <div class="space-y-4 font-body text-base leading-relaxed text-slate-600">
      <p>{visionSection.vision}</p>
      <p>We want to become a trusted partner for organisations that look to innovate, improve the way they operate and achieve lasting performance improvements.</p>
    </div>
  </section>

  <section class="mt-20 grid items-start gap-10 lg:grid-cols-2 lg:gap-16">
    <div>
      <p class={eyebrow}>Who we are</p>
      <h2 class={`${h2} mt-2`}>A multidisciplinary engineering company</h2>
      <div class="mt-5 space-y-4 font-body text-base leading-relaxed text-slate-600">
        <p>FluiDimensions is an engineering solutions company with a strong foundation in chemical engineering, computational modelling, process engineering and technology development.</p>
        <p>We place particular emphasis on technically challenging problems that need deeper engineering understanding, rather than standard tools or routine analysis.</p>
      </div>
    </div>
    <ol class="space-y-3">
      {APPROACH.map(([title, text], i) => (
        <li class="flex gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent font-heading text-sm font-bold text-white">{i + 1}</span><div><h3 class="font-heading text-base font-bold text-primary">{title}</h3><p class="mt-1 font-body text-sm leading-relaxed text-slate-600">{text}</p></div></li>
      ))}
    </ol>
  </section>

  <section class="mt-20">
    <p class={eyebrow}>Capabilities</p>
    <h2 class={`${h2} mt-2`}>What we bring together</h2>
    <p class="mt-4 max-w-3xl font-body text-base leading-relaxed text-slate-600">Our capabilities are not isolated service offerings. We combine them as appropriate to develop solutions that address the engineering problem as a whole.</p>
    <ul class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {CAPS.filter((c) => c.t !== 'Digital Engineering').map((c) => (
        <li><a href={capLink[c.id]} class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-accent/40 hover:shadow-lg"><h3 class="font-heading text-base font-bold text-primary group-hover:text-accent">{c.t}</h3><p class="mt-2 flex-1 font-body text-sm leading-relaxed text-slate-600">{c.d}</p><span class="mt-4 inline-flex items-center gap-1 font-heading text-xs font-bold text-secondary">Explore <Icon name="ion:arrow-forward" class="h-4 w-4" aria-hidden="true" /></span></a></li>
      ))}
    </ul>
    <p class="mt-8 text-sm font-semibold text-slate-700">Industries we serve</p>
    <ul class="mt-3 flex flex-wrap gap-2">{industryPages.map((p) => <li><a href={p.path} class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-accent hover:text-accent">{p.label}</a></li>)}</ul>
  </section>

  <section class="mt-20 rounded-3xl border border-sky-200 bg-sky-100 px-6 py-12 sm:px-12">
    <p class={eyebrow}>Our philosophy</p>
    <h2 class={`${h2} mt-2 max-w-3xl`}>Understand the problem. Apply the right engineering. Deliver a practical solution.</h2>
    <p class="mt-5 max-w-3xl font-body text-base leading-relaxed text-slate-600">Advanced technology is valuable only when it helps answer the right engineering question. A sophisticated simulation, a predictive model or a customised software tool is not an end in itself. Its value lies in the understanding it creates, the decisions it supports and the improvements it enables.</p>
  </section>

  <section class="mt-20">
    <p class={eyebrow}>Values</p>
    <h2 class={`${h2} mt-2`}>Passion. Integrity. Commitment.</h2>
    <ul class="mt-8 grid gap-5 md:grid-cols-3">
      {VALUES.map(([title, subtitle, text]) => <li class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm"><p class="text-xs font-bold uppercase tracking-widest text-accent">{title}</p><h3 class="mt-3 font-heading text-lg font-bold text-primary">{subtitle}</h3><p class="mt-3 font-body text-sm leading-relaxed text-slate-600">{text}</p></li>)}
    </ul>
  </section>

  <section class="mt-20 max-w-3xl">
    <p class={eyebrow}>Technical leadership</p>
    <h2 class={`${h2} mt-2`}>Research depth and industrial experience</h2>
    <div class="mt-5 space-y-4 font-body text-base leading-relaxed text-slate-600">
      <p>FluiDimensions is led by a chemical engineering professional with a Ph.D. and postdoctoral research experience, and over 25 years of experience across industrial engineering, research and development, and technology development.</p>
      <p>Experience includes senior technical and managerial roles at UOP India and Aditya Birla Science and Technology Centre, alongside research collaborations, academic engagement and engineering consultancy.</p>
    </div>
  </section>

  <Cta heading="Let’s talk about your engineering challenge" text="FluiDimensions: engineering expertise, practical solutions, lasting performance." />
</PageLayout>
