---
import { Icon } from 'astro-icon/components';
import Cta from './Cta.astro';
import { CAPS, MLCAP, STAGES, SWCAP, INEFF, EQUIP, IND, INDS, STUB_AREAS } from '../../data/doc';

interface Props { kind: 'capability' | 'industry'; id: string }
const { kind, id } = Astro.props;

const capPath: Record<string, string> = { simulation: '/engineering-simulation/', process: '/chemical-engineering-process-consulting/', design: '/engineering-design/', ml: '/machine-learning-data-intelligence/', software: '/software-automation/' };
const related = CAPS.filter((c) => c.id !== id && c.t !== 'Digital Engineering').slice(0, 3);
const industry = kind === 'industry' ? IND[id as keyof typeof IND] : null;
const indMeta = INDS.find((i) => i.id === id);

// Equal-weight colour tones, cycled so no single topic looks more important than another.
const tones = [
  { chip: 'bg-sky-100 text-sky-900 border-sky-200', num: 'bg-sky-600', head: 'bg-sky-50', border: 'border-sky-200', bar: 'border-t-sky-500' },
  { chip: 'bg-emerald-100 text-emerald-900 border-emerald-200', num: 'bg-emerald-600', head: 'bg-emerald-50', border: 'border-emerald-200', bar: 'border-t-emerald-500' },
  { chip: 'bg-violet-100 text-violet-900 border-violet-200', num: 'bg-violet-600', head: 'bg-violet-50', border: 'border-violet-200', bar: 'border-t-violet-500' },
  { chip: 'bg-amber-100 text-amber-900 border-amber-200', num: 'bg-amber-600', head: 'bg-amber-50', border: 'border-amber-200', bar: 'border-t-amber-500' },
  { chip: 'bg-rose-100 text-rose-900 border-rose-200', num: 'bg-rose-600', head: 'bg-rose-50', border: 'border-rose-200', bar: 'border-t-rose-500' },
  { chip: 'bg-cyan-100 text-cyan-900 border-cyan-200', num: 'bg-cyan-600', head: 'bg-cyan-50', border: 'border-cyan-200', bar: 'border-t-cyan-500' },
];
const tone = (i: number) => tones[i % tones.length];

// "On this page" menu entries
let toc: { id: string; label: string }[] = [];
if (kind === 'capability' && id === 'ml') toc = [{ id: 'capabilities', label: 'Capabilities' }, { id: 'adoption', label: 'Progressive adoption' }, { id: 'related', label: 'Related capabilities' }];
if (kind === 'capability' && id === 'software') toc = [{ id: 'capabilities', label: 'Capabilities' }, { id: 'experience', label: 'Experience' }, { id: 'related', label: 'Related capabilities' }];
if (kind === 'capability' && id === 'design') toc = [{ id: 'overview', label: 'Overview' }, { id: 'equipment', label: 'Equipment' }, { id: 'what', label: 'What we do' }, { id: 'related', label: 'Related capabilities' }];
if (kind === 'capability' && id === 'process') toc = [{ id: 'consulting', label: 'Consulting' }, { id: 'inefficiency', label: 'Where performance is lost' }, { id: 'related', label: 'Related capabilities' }];
if (kind === 'industry' && industry) toc = [{ id: 'overview', label: 'Overview' }, ...industry.areas.map((a, i) => ({ id: `item-${i}`, label: a.t.replace(/^[^:]*:\s*/, '') })), ...(id === 'pharma' ? [{ id: 'examples', label: 'Examples' }] : []), { id: 'related', label: 'Related capabilities' }];
if (kind === 'industry' && !industry) toc = [{ id: 'overview', label: 'Overview' }, { id: 'related', label: 'Related capabilities' }];

const h2 = 'font-heading text-2xl font-bold text-primary sm:text-3xl';
const eyebrow = 'text-sm font-bold uppercase tracking-widest text-accent';
const body = 'font-body text-base leading-relaxed text-slate-700';
---
<div class="grid grid-cols-1 gap-10 lg:grid-cols-[230px_minmax(0,1fr)] lg:gap-12">
  <aside class="min-w-0 lg:sticky lg:top-28 lg:self-start">
    <p class="mb-3 hidden text-xs font-bold uppercase tracking-widest text-slate-500 lg:block">On this page</p>
    <ul class="flex gap-2 overflow-x-auto pb-2 lg:block lg:space-y-1 lg:border-l-2 lg:border-slate-300 lg:pb-0" aria-label="On this page">
      {toc.map((entry, i) => (
        <li class="shrink-0"><a href={`#${entry.id}`} class="block whitespace-nowrap rounded-full border border-slate-300 bg-white px-4 py-1.5 text-sm font-medium text-slate-700 transition hover:border-accent hover:text-accent lg:-ml-[2px] lg:whitespace-normal lg:rounded-none lg:border-0 lg:border-l-2 lg:border-transparent lg:bg-transparent lg:px-4 lg:py-2 lg:hover:border-accent">{entry.label}</a></li>
      ))}
    </ul>
  </aside>

  <div class="min-w-0 space-y-16">
    {kind === 'capability' && (id === 'ml' || id === 'software') && (
      <>
        <section id="capabilities" class="scroll-mt-28">
          <p class={eyebrow}>Capabilities</p>
          <h2 class={`${h2} mt-2`}>{id === 'ml' ? 'Transforming process data into engineering insight' : 'Converting engineering knowledge into software'}</h2>
          <p class={`${body} mt-4 max-w-3xl`}>{id === 'ml' ? 'Machine learning is not treated as an isolated analysis activity. Meaningful insight emerges when process data is interpreted in the context of the underlying physical and chemical phenomena.' : 'We do not treat software as a programming exercise. Solutions are built around the engineering problem, the underlying physics and the intended use.'}</p>
          <div class="mt-8 grid gap-6 md:grid-cols-2">
            {(id === 'ml' ? MLCAP : SWCAP).map((m, i) => (
              <article class={`flex flex-col overflow-hidden rounded-2xl border border-slate-300 border-t-4 bg-white shadow-sm ${tone(i).bar}`}>
                <header class={`flex items-center gap-3 border-b px-6 py-4 ${tone(i).head} ${tone(i).border}`}><span class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-lg font-heading text-sm font-bold text-white ${tone(i).num}`}>{i + 1}</span><h3 class="font-heading text-lg font-bold text-primary">{m[0]}</h3></header>
                <div class="flex flex-1 flex-col gap-4 p-6"><p class="font-body text-sm leading-relaxed text-slate-700">{m[1]}</p>
                  <ul class="space-y-2 rounded-xl bg-slate-50 p-4 font-body text-sm text-slate-700">{(m[2] as string[]).map((b) => <li class="flex gap-2"><Icon name="ion:checkmark-circle" class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600" aria-hidden="true" />{b}</li>)}</ul>
                </div>
              </article>
            ))}
          </div>
        </section>
        {id === 'ml' && (
          <section id="adoption" class="scroll-mt-28 rounded-2xl border border-slate-300 bg-white p-6 shadow-sm sm:p-8">
            <p class={eyebrow}>Progressive adoption</p>
            <h2 class={`${h2} mt-2`}>From offline analysis to intelligent automation</h2>
            <p class={`${body} mt-4 max-w-3xl`}>Industrial processes cannot be entrusted to automated intelligence overnight. Confidence in predictive models must be built through validation under real operating conditions, so clients can move towards greater automation as confidence grows.</p>
            <ol class="mt-8 space-y-3">
              {STAGES.map((s, i) => (
                <li class={`flex gap-4 rounded-xl border p-5 ${tone(i).head} ${tone(i).border}`}><span class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full font-heading text-sm font-bold text-white ${tone(i).num}`}>{i + 1}</span><div><h3 class="font-heading text-base font-bold text-primary">{s[0]}</h3><p class="mt-1 font-body text-sm leading-relaxed text-slate-700">{s[1]}</p></div></li>
              ))}
            </ol>
          </section>
        )}
        {id === 'software' && (
          <section id="experience" class="scroll-mt-28 rounded-2xl border border-emerald-200 bg-emerald-50 p-6 sm:p-8">
            <p class={eyebrow}>Experience</p>
            <h2 class={`${h2} mt-2`}>Automation built from real workflows</h2>
            <p class={`${body} mt-4`}>We have developed automated simulation workflows for stirred tank reactors, cyclone separators and two-phase separators used in oil and gas. Our automation experience includes integration with commercial CFD platforms such as ANSYS and STAR-CCM+, and GUI-based automation of OpenFOAM workflows.</p>
            <p class={`${body} mt-3`}>The aim is to encapsulate engineering expertise in structured workflows that make advanced simulation more accessible, consistent and efficient.</p>
          </section>
        )}
      </>
    )}

    {kind === 'capability' && id === 'design' && (
      <>
        <section id="overview" class="scroll-mt-28 rounded-2xl border border-sky-200 bg-sky-50 p-6 sm:p-8">
          <p class={eyebrow}>Process &amp; equipment design</p>
          <h2 class={`${h2} mt-2`}>Design decisions backed by engineering analysis</h2>
          <p class={`${body} mt-4`}>We apply chemical engineering principles and simulation-based insight to the design, evaluation and improvement of process equipment and reactors, covering configuration, sizing, geometry, internals, distribution arrangements and integration with the overall process.</p>
          <p class={`${body} mt-3`}>Together with process modelling and simulation, this supports new equipment development, design improvements, scale-up studies, retrofits and performance enhancement of existing systems.</p>
        </section>
        <section id="equipment" class="scroll-mt-28">
          <p class={eyebrow}>Equipment</p>
          <h2 class={`${h2} mt-2`}>Equipment we evaluate and design</h2>
          <ul class="mt-6 flex flex-wrap gap-3">{EQUIP.map((e, i) => <li class={`rounded-full border px-4 py-2 font-heading text-sm font-semibold ${tone(i).chip}`}>{e}</li>)}</ul>
        </section>
        <section id="what" class="scroll-mt-28">
          <p class={eyebrow}>What we do</p>
          <h2 class={`${h2} mt-2`}>From concept to improvement</h2>
          <div class="mt-6 grid gap-5 md:grid-cols-3">
            {[['Equipment configuration and sizing', 'Geometry, internals and distribution arrangements matched to the process.'], ['Design evaluation and comparison', 'Alternatives compared on a consistent engineering basis.'], ['Scale-up, retrofits and improvement', 'Engineering input when changing scale or upgrading existing systems.']].map(([t, d], i) => (
              <div class={`rounded-2xl border border-slate-300 border-t-4 bg-white p-6 shadow-sm ${tone(i).bar}`}><h3 class="font-heading text-lg font-bold text-primary">{t}</h3><p class="mt-2 font-body text-sm leading-relaxed text-slate-600">{d}</p></div>
            ))}
          </div>
        </section>
      </>
    )}

    {kind === 'capability' && id === 'process' && (
      <>
        <section id="consulting" class="scroll-mt-28">
          <p class={eyebrow}>Consulting</p>
          <h2 class={`${h2} mt-2`}>Interpreting results in the context of the real process</h2>
          <p class={`${body} mt-4 max-w-3xl`}>Engagements range from engineering interpretation within technical projects to dedicated troubleshooting, optimisation and consulting assignments.</p>
          <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {[['Process troubleshooting and root-cause analysis', 'Investigating operational problems and identifying their underlying causes.'], ['Process and plant performance optimisation', 'Throughput, productivity, energy efficiency, yield and product quality.'], ['Equipment performance evaluation', 'Identifying design and operational limitations and recommending improvements.'], ['Process and equipment design', 'Process development, design evaluation, modifications and equipment improvement.'], ['Advanced engineering investigations', 'CFD, process modelling, multiphase and combustion analysis, FEA and data analytics applied to complex problems.']].map(([t, d], i) => (
              <div class={`rounded-2xl border border-slate-300 border-t-4 bg-white p-6 shadow-sm ${tone(i).bar}`}><span class={`inline-flex h-9 w-9 items-center justify-center rounded-lg font-heading text-sm font-bold text-white ${tone(i).num}`}>{i + 1}</span><h3 class="mt-4 font-heading text-lg font-bold text-primary">{t}</h3><p class="mt-2 font-body text-sm leading-relaxed text-slate-600">{d}</p></div>
            ))}
          </div>
        </section>
        <section id="inefficiency" class="scroll-mt-28">
          <p class={eyebrow}>Process industry inefficiency</p>
          <h2 class={`${h2} mt-2`}>Where performance is lost, and how we help</h2>
          <div class="mt-8 overflow-x-auto rounded-2xl border border-slate-300 bg-white shadow-sm">
            <table class="w-full min-w-[680px] text-left text-sm">
              <thead class="bg-primary text-xs font-bold uppercase tracking-wider text-white"><tr><th class="px-5 py-3.5">Area of inefficiency</th><th class="px-5 py-3.5">Description</th><th class="px-5 py-3.5">Relevant capabilities</th></tr></thead>
              <tbody class="divide-y divide-slate-200">{INEFF.map((r, i) => <tr class={i % 2 ? 'bg-sky-50/60' : ''}><td class="px-5 py-4 font-semibold text-primary">{r[0]}</td><td class="px-5 py-4 text-slate-700">{r[1]}</td><td class="px-5 py-4"><span class="inline-block rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-900">{r[2]}</span></td></tr>)}</tbody>
            </table>
          </div>
        </section>
      </>
    )}

    {kind === 'industry' && industry && (
      <>
        <section id="overview" class="scroll-mt-28 rounded-2xl border border-sky-200 bg-sky-50 p-6 sm:p-8">
          <p class={eyebrow}>Overview</p>
          <h2 class={`${h2} mt-2`}>Understanding the engineering behind performance</h2>
          <div class={`${body} mt-4 space-y-3`}>{industry.intro.map((p) => <p>{p}</p>)}</div>
          {(industry as any).basis && <p class="mt-5 flex gap-3 rounded-xl border border-slate-300 bg-white p-4 font-body text-sm text-slate-600"><Icon name="ion:information-circle-outline" class="mt-0.5 h-5 w-5 shrink-0 text-secondary" aria-hidden="true" />{(industry as any).basis}</p>}
        </section>
        <div class="space-y-8">
          {industry.areas.map((a, i) => (
            <article id={`item-${i}`} class="scroll-mt-28 overflow-hidden rounded-2xl border border-slate-300 bg-white shadow-sm">
              <header class={`flex items-center gap-4 border-b px-6 py-5 ${tone(i).head} ${tone(i).border}`}>
                <span class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-xl font-heading text-lg font-bold text-white ${tone(i).num}`}>{i + 1}</span>
                <h3 class="font-heading text-xl font-bold text-primary">{a.t}</h3>
              </header>
              <div class="space-y-5 p-6 sm:p-8">
                <div class="grid gap-5 md:grid-cols-2">
                  <div class="rounded-xl border border-amber-200 bg-amber-50 p-5">
                    <p class="flex items-center gap-2 font-heading text-sm font-bold text-amber-900"><Icon name="ion:alert-circle-outline" class="h-5 w-5" aria-hidden="true" /> Problems we can help address</p>
                    <ul class="mt-3 space-y-2 font-body text-sm text-slate-700">{a.p.map((x) => <li class="flex gap-2"><Icon name="ion:chevron-forward" class="mt-0.5 h-4 w-4 shrink-0 text-amber-600" aria-hidden="true" />{x}</li>)}</ul>
                  </div>
                  <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-5">
                    <p class="flex items-center gap-2 font-heading text-sm font-bold text-emerald-900"><Icon name="ion:checkmark-circle-outline" class="h-5 w-5" aria-hidden="true" /> What this can deliver</p>
                    <ul class="mt-3 space-y-2 font-body text-sm text-slate-700">{a.d.map((x) => <li class="flex gap-2"><Icon name="ion:checkmark-circle" class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600" aria-hidden="true" />{x}</li>)}</ul>
                  </div>
                </div>
                {a.note && <p class="flex gap-3 rounded-xl border border-slate-300 bg-slate-100 p-4 font-body text-sm text-slate-700"><Icon name="ion:information-circle-outline" class="mt-0.5 h-5 w-5 shrink-0 text-secondary" aria-hidden="true" />{a.note}</p>}
              </div>
            </article>
          ))}
        </div>
        {id === 'pharma' && (
          <section id="examples" class="scroll-mt-28">
            <p class={eyebrow}>Examples</p>
            <h2 class={`${h2} mt-2`}>From detailed simulation to process intelligence</h2>
            <div class="mt-6 grid gap-6 md:grid-cols-2">
              <article class="rounded-2xl border border-slate-300 border-t-4 border-t-sky-500 bg-white p-6 shadow-sm">
                <span class="rounded-full bg-sky-100 px-3 py-1 text-xs font-bold text-sky-900">Example</span>
                <h3 class="mt-3 font-heading text-lg font-bold text-primary">CFD to fast performance prediction</h3>
                <p class="mt-2 font-body text-sm leading-relaxed text-slate-700">Reactor simulations at different operating volumes and impeller speeds (STAR-CCM+, Fluent) were converted into reduced-order models (Siemens ROM Builder, Python) that predict average shear, mixing time and power consumption, deployed through a Python and Streamlit interface. It helps compare available reactors for a production requirement without a full simulation each time.</p>
                <p class="mt-4 flex gap-3 rounded-xl border border-slate-300 bg-slate-100 p-4 font-body text-sm text-slate-700"><Icon name="ion:information-circle-outline" class="mt-0.5 h-5 w-5 shrink-0 text-secondary" aria-hidden="true" />A model-based prediction and decision-support tool, not a live digital twin connected to plant data.</p>
              </article>
              <article class="rounded-2xl border border-slate-300 border-t-4 border-t-amber-500 bg-white p-6 shadow-sm">
                <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-900">Demonstration</span>
                <h3 class="mt-3 font-heading text-lg font-bold text-primary">Ferment IQ</h3>
                <p class="mt-2 font-body text-sm leading-relaxed text-slate-700">Monitor critical parameters, compare batches with Golden Batch references, predict KPIs with machine learning, and explore deviations with an AI process assistant and an offline simulator.</p>
                <p class="mt-4 flex gap-3 rounded-xl border border-slate-300 bg-slate-100 p-4 font-body text-sm text-slate-700"><Icon name="ion:information-circle-outline" class="mt-0.5 h-5 w-5 shrink-0 text-secondary" aria-hidden="true" />Presented as a demonstration of what can be developed around your process, not as a finished, validated pharmaceutical manufacturing solution.</p>
              </article>
            </div>
          </section>
        )}
      </>
    )}

    {kind === 'industry' && !industry && (
      <section id="overview" class="scroll-mt-28 rounded-2xl border border-sky-200 bg-sky-50 p-6 sm:p-8">
        <p class={eyebrow}>Overview</p>
        <h2 class={`${h2} mt-2`}>{indMeta?.t}</h2>
        <p class={`${body} mt-3`}>{indMeta?.tag}</p>
        <p class="mt-6 text-sm font-bold uppercase tracking-widest text-secondary">Where our capabilities apply</p>
        <ul class="mt-4 space-y-3">{(STUB_AREAS[id as keyof typeof STUB_AREAS] ?? []).map((x, i) => <li class={`flex gap-3 rounded-xl border p-4 font-body text-sm text-slate-800 ${tone(i).head} ${tone(i).border}`}><span class={`flex h-7 w-7 shrink-0 items-center justify-center rounded-full font-heading text-xs font-bold text-white ${tone(i).num}`}>{i + 1}</span>{x}</li>)}</ul>
        <p class="mt-6 flex gap-3 rounded-xl border border-slate-300 bg-white p-4 font-body text-sm text-slate-600"><Icon name="ion:information-circle-outline" class="mt-0.5 h-5 w-5 shrink-0 text-secondary" aria-hidden="true" />These are application areas for our engineering capabilities, not a list of completed projects. A detailed industry page is in preparation.</p>
      </section>
    )}

    <section id="related" class="scroll-mt-28">
      <p class={eyebrow}>Related capabilities</p>
      <h2 class={`${h2} mt-2`}>Used together, not in isolation</h2>
      <ul class="mt-6 grid gap-5 md:grid-cols-3">
        {(kind === 'industry' ? CAPS.filter((c) => c.t !== 'Digital Engineering').slice(0, 3) : related).map((c, i) => (
          <li><a href={capPath[c.id]} class={`group flex h-full flex-col rounded-2xl border border-slate-300 border-t-4 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg ${tone(i).bar}`}><h3 class="font-heading text-base font-bold text-primary group-hover:text-accent">{c.t}</h3><p class="mt-2 flex-1 font-body text-sm leading-relaxed text-slate-600">{c.d}</p><span class="mt-4 inline-flex items-center gap-1 font-heading text-xs font-bold text-secondary">Explore <Icon name="ion:arrow-forward" class="h-4 w-4" aria-hidden="true" /></span></a></li>
        ))}
      </ul>
    </section>
  </div>
</div>
<Cta />
