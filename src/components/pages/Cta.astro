---
import { Icon } from 'astro-icon/components';
import { CONTACT_BUSINESS } from '../../data/site';
interface Props { heading?: string; text?: string; label?: string }
const { heading = 'Have an engineering challenge to discuss?', text = 'Tell us about your process, equipment or engineering problem. We would be glad to explore how we can help.', label = 'Discuss an Engineering Challenge' } = Astro.props;
---
<section class="mt-20 overflow-hidden rounded-3xl bg-primary px-6 py-12 text-center sm:px-12 sm:py-14">
  <h2 class="mx-auto max-w-2xl font-heading text-2xl font-bold text-white sm:text-3xl">{heading}</h2>
  <p class="mx-auto mt-4 max-w-2xl font-body text-base leading-7 text-slate-300">{text}</p>
  <a href={CONTACT_BUSINESS} class="mt-7 inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-accent px-7 font-heading text-sm font-semibold text-white transition hover:bg-accent-dark">{label} <Icon name="ion:arrow-forward" class="h-4 w-4" aria-hidden="true" /></a>
</section>
