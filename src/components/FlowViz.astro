---
// Illustrative 3D flow animation (potential flow around a cylinder). Not project data.
---
<figure class="flow-viz relative overflow-hidden rounded-2xl border border-white/20 bg-primary/60 shadow-2xl backdrop-blur" data-flow-viz>
  <div class="relative aspect-[4/3] w-full">
    <canvas class="block h-full w-full cursor-grab touch-pan-y" role="img" aria-label="Animated 3D visualisation of flow particles passing around a cylinder inside a duct, coloured by velocity"></canvas>
    <button type="button" data-flow-toggle aria-pressed="false" class="absolute right-3 top-3 min-h-9 rounded-lg border border-white/25 bg-primary/80 px-3 text-xs font-semibold text-white hover:border-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300">Pause</button>
    <p data-flow-fallback class="absolute inset-0 hidden place-content-center p-6 text-center text-sm text-slate-300">The 3D view is not available in this browser.</p>
  </div>
  <figcaption class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-white/15 px-4 py-3 text-xs text-slate-300">
    <span class="flex min-w-[10rem] flex-1 flex-col gap-1">
      <span class="font-semibold uppercase tracking-widest">Velocity (illustrative)</span>
      <span class="h-2 rounded-full border border-white/20" style="background:linear-gradient(90deg,#1E3A8A,#1D63C8 25%,#22D3EE 50%,#FACC15 75%,#FF6B00)"></span>
    </span>
    <span>Illustrative model, not project data. Drag to rotate.</span>
  </figcaption>
</figure>

<script>
  import {
    WebGLRenderer, Scene, PerspectiveCamera, PlaneGeometry, MeshBasicMaterial, Mesh, DoubleSide, LineSegments,
    EdgesGeometry, BoxGeometry, LineBasicMaterial, GridHelper, CylinderGeometry, WireframeGeometry, BufferGeometry,
    BufferAttribute, DynamicDrawUsage, CanvasTexture, LinearFilter,
  } from 'three';

  const root = document.querySelector<HTMLElement>('[data-flow-viz]');
  if (root) {
    const canvas = root.querySelector('canvas')!;
    const fb = root.querySelector<HTMLElement>('[data-flow-fallback]')!;
    const btn = root.querySelector<HTMLButtonElement>('[data-flow-toggle]')!;
    const showFallback = () => { fb.classList.remove('hidden'); fb.classList.add('grid'); btn.hidden = true; };
    let renderer: WebGLRenderer | null = null;
    try { renderer = new WebGLRenderer({ canvas, antialias: true, alpha: true }); } catch { showFallback(); }
    if (renderer) init(renderer, root.querySelector<HTMLElement>('.relative')!, btn);
  }

  function init(renderer: WebGLRenderer, stage: HTMLElement, btn: HTMLButtonElement) {
    const canvas = renderer.domElement;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    const scene = new Scene();
    const camera = new PerspectiveCamera(38, 4 / 3, 0.1, 100);
    const LX = 6, LY = 1.5, LZ = 1.5, R = 0.72;
    const stops: [number, number[]][] = [[0, [30, 58, 138]], [.25, [29, 99, 200]], [.5, [34, 211, 238]], [.75, [250, 204, 21]], [1, [255, 107, 0]]];
    const cmap = (v: number) => {
      v = Math.max(0, Math.min(1, v));
      for (let i = 1; i < stops.length; i++) {
        if (v <= stops[i][0]) { const a = stops[i - 1], b = stops[i], k = (v - a[0]) / (b[0] - a[0]); return [0, 1, 2].map((n) => a[1][n] + (b[1][n] - a[1][n]) * k); }
      }
      return stops[4][1];
    };
    const field = (x: number, y: number, t: number, out: number[]) => {
      let r2 = x * x + y * y; if (r2 < R * R) r2 = R * R;
      const f = R * R / (r2 * r2);
      let u = 1 - f * (x * x - y * y), v = -2 * f * x * y;
      if (x > 0) { const w = Math.exp(-0.12 * x) * (1 - Math.exp(-1.4 * x)); v += 0.42 * w * Math.sin(2.3 * x - 2.4 * t); u -= 0.25 * w; }
      out[0] = u; out[1] = v;
    };

    const cw = 256, ch = 96, cv = document.createElement('canvas'); cv.width = cw; cv.height = ch;
    const cx = cv.getContext('2d')!, img = cx.createImageData(cw, ch), tmp = [0, 0];
    for (let j = 0; j < ch; j++) for (let i = 0; i < cw; i++) {
      const x = -LX + (i + .5) / cw * 2 * LX, y = LY - (j + .5) / ch * 2 * LY, k = (j * cw + i) * 4;
      if (x * x + y * y < R * R) { img.data[k + 3] = 0; continue; }
      field(x, y, 0, tmp); const c = cmap(Math.hypot(tmp[0], tmp[1]) / 1.9);
      img.data[k] = c[0]; img.data[k + 1] = c[1]; img.data[k + 2] = c[2]; img.data[k + 3] = 215;
    }
    cx.putImageData(img, 0, 0);
    const tex = new CanvasTexture(cv); tex.minFilter = LinearFilter;
    const wall = new Mesh(new PlaneGeometry(2 * LX, 2 * LY), new MeshBasicMaterial({ map: tex, transparent: true, opacity: .55, side: DoubleSide }));
    wall.position.z = -LZ; scene.add(wall);
    scene.add(new LineSegments(new EdgesGeometry(new BoxGeometry(2 * LX, 2 * LY, 2 * LZ)), new LineBasicMaterial({ color: 0x5C7FB0, transparent: true, opacity: .7 })));
    const grid = new GridHelper(2 * LX, 24, 0x2A4A7A, 0x1B3560); grid.position.y = -LY - 0.02; grid.scale.z = 0.5; scene.add(grid);
    const cyl = new CylinderGeometry(R, R, 2 * LZ, 40, 1, false); cyl.rotateX(Math.PI / 2);
    scene.add(new Mesh(cyl, new MeshBasicMaterial({ color: 0x0E2A52 })));
    scene.add(new LineSegments(new WireframeGeometry(new CylinderGeometry(R * 1.003, R * 1.003, 2 * LZ, 28, 10, true).rotateX(Math.PI / 2)), new LineBasicMaterial({ color: 0xFF6B00, transparent: true, opacity: .6 })));

    const N = 380, T = 16, pos = new Float32Array(N * 3), spd = new Float32Array(N), hist = new Float32Array(N * T * 3);
    const segPos = new Float32Array(N * (T - 1) * 6), segCol = new Float32Array(N * (T - 1) * 6);
    const geo = new BufferGeometry();
    geo.setAttribute('position', new BufferAttribute(segPos, 3).setUsage(DynamicDrawUsage));
    geo.setAttribute('color', new BufferAttribute(segCol, 3).setUsage(DynamicDrawUsage));
    const lines = new LineSegments(geo, new LineBasicMaterial({ vertexColors: true, transparent: true, opacity: .95 }));
    lines.frustumCulled = false; scene.add(lines);
    const spawn = (p: number, anywhere: boolean) => {
      pos[p * 3] = anywhere ? -LX + Math.random() * 2 * LX : -LX;
      pos[p * 3 + 1] = (Math.random() * 2 - 1) * (LY - .1);
      pos[p * 3 + 2] = (Math.random() * 2 - 1) * (LZ - .1);
      for (let q = 0; q < T; q++) for (let n = 0; n < 3; n++) hist[(p * T + q) * 3 + n] = pos[p * 3 + n];
    };
    for (let p = 0; p < N; p++) { spawn(p, true); const x0 = pos[p * 3], y0 = pos[p * 3 + 1]; if (x0 * x0 + y0 * y0 < R * R * 1.1) spawn(p, false); }

    const bg = [7 / 255, 27 / 255, 58 / 255];
    const step = (dt: number, t: number) => {
      const o = [0, 0];
      for (let p = 0; p < N; p++) {
        let x = pos[p * 3], y = pos[p * 3 + 1], z = pos[p * 3 + 2];
        field(x, y, t, o); spd[p] = Math.hypot(o[0], o[1]);
        x += o[0] * dt * 2.1; y += o[1] * dt * 2.1; z += Math.sin(t * 0.9 + p) * dt * 0.12;
        const r2 = x * x + y * y;
        if (r2 < R * R * 1.04) { const r = Math.sqrt(r2) || 1e-3, k = R * 1.05 / r; x *= k; y *= k; }
        if (x > LX || Math.abs(y) > LY || Math.abs(z) > LZ) { spawn(p, false); continue; }
        pos[p * 3] = x; pos[p * 3 + 1] = y; pos[p * 3 + 2] = z;
        for (let q = T - 1; q > 0; q--) for (let n = 0; n < 3; n++) hist[(p * T + q) * 3 + n] = hist[(p * T + q - 1) * 3 + n];
        hist[p * T * 3] = x; hist[p * T * 3 + 1] = y; hist[p * T * 3 + 2] = z;
      }
      let w = 0;
      for (let p = 0; p < N; p++) {
        const c = cmap(spd[p] / 1.9);
        for (let q = 0; q < T - 1; q++) {
          const f2 = Math.pow(1 - q / (T - 1), 1.4), f1 = Math.pow(1 - (q + 1) / (T - 1), 1.4);
          for (const [qq, f] of [[q, f2], [q + 1, f1]] as [number, number][]) {
            const a = (p * T + qq) * 3;
            segPos[w] = hist[a]; segPos[w + 1] = hist[a + 1]; segPos[w + 2] = hist[a + 2];
            for (let n = 0; n < 3; n++) segCol[w + n] = bg[n] + (c[n] / 255 - bg[n]) * f;
            w += 3;
          }
        }
      }
      geo.attributes.position.needsUpdate = true; geo.attributes.color.needsUpdate = true;
    };

    let dragAz = 0, dragEl = 0, dragging = false, lastX = 0, lastY = 0, playing = !reduce, t = 0, last = performance.now(), visible = true;
    const draw = () => {
      const a = 0.55 * Math.sin(t * 0.18) + dragAz, el = 0.28 + dragEl, d = 14.5;
      camera.position.set(d * Math.sin(a) * Math.cos(el), d * Math.sin(el), d * Math.cos(a) * Math.cos(el));
      camera.lookAt(0.6, 0, 0);
      renderer.render(scene, camera);
    };
    canvas.addEventListener('pointerdown', (e) => { dragging = true; lastX = e.clientX; lastY = e.clientY; canvas.setPointerCapture(e.pointerId); });
    canvas.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      dragAz -= (e.clientX - lastX) * 0.006; dragEl = Math.max(-.2, Math.min(.9, dragEl + (e.clientY - lastY) * 0.004));
      lastX = e.clientX; lastY = e.clientY; if (!playing) draw();
    });
    const end = () => { dragging = false; };
    canvas.addEventListener('pointerup', end); canvas.addEventListener('pointercancel', end);

    const resize = () => {
      const w = stage.clientWidth, h = stage.clientHeight; if (!w || !h) return;
      renderer.setSize(w, h, false); camera.aspect = w / h; camera.fov = w < 420 ? 52 : 38; camera.updateProjectionMatrix(); draw();
    };
    new ResizeObserver(resize).observe(stage);
    new IntersectionObserver((e) => { visible = e[0].isIntersecting; last = performance.now(); }).observe(stage);
    resize();
    for (let i = 0; i < 120; i++) { t += 0.03; step(0.03, t); }
    draw();
    const setBtn = () => { btn.textContent = playing ? 'Pause' : 'Play'; btn.setAttribute('aria-pressed', String(!playing)); };
    btn.addEventListener('click', () => { playing = !playing; setBtn(); last = performance.now(); });
    setBtn();
    const loop = (now: number) => {
      const dt = Math.min((now - last) / 1000, 0.05); last = now;
      if (visible && !document.hidden) {
        if (playing) { t += dt; step(dt, t); if (!dragging) { dragAz *= 0.995; dragEl *= 0.995; } }
        draw();
      }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame((n) => { last = n; requestAnimationFrame(loop); });
  }
</script>
