---
import { Icon } from 'astro-icon/components';
import { capabilityPages, industryPages } from '../data/site';

const columns = [
  { title: 'Company', links: [['Home', '/'], ['About Us', '/about-us/'], ['Technologies & Software', '/engineering-technologies-software/'], ['Engineering Cafe', '/engineering-cafe/'], ['Blog', '/blog/'], ['Contact', '/contact/']] },
  { title: 'Engineering', links: capabilityPages.map((page) => [page.label, page.path]) },
  { title: 'Industries', links: [...industryPages.slice(0, 6).map((page) => [page.label, page.path]), ['All industries', '/#industries']] },
];
// TODO(confirm): replace with the company's real profile URLs.
const socials = [
  { icon: 'ion:logo-linkedin', href: 'https://www.linkedin.com', label: 'LinkedIn', tone: 'from-sky-600 to-blue-700' },
  { icon: 'ion:logo-twitter', href: 'https://twitter.com', label: 'Twitter', tone: 'from-cyan-500 to-sky-400' },
  { icon: 'ion:logo-youtube', href: 'https://www.youtube.com', label: 'YouTube', tone: 'from-red-500 to-rose-500' },
];
---
<footer class="relative overflow-hidden border-t border-white/5 bg-primary text-white">
  <div class="cfd-grid pointer-events-none absolute inset-0 opacity-5"></div>
  <div class="site-container relative z-10 pb-20 pt-12 sm:pb-6 sm:pt-12">
    <div class="mb-8 grid grid-cols-2 gap-x-5 gap-y-6 lg:mb-8 lg:grid-cols-5 lg:gap-6">
      <div class="col-span-2 min-w-0 lg:pr-8">
        <a href="/" class="mb-4 flex w-fit items-center gap-3 rounded-lg" aria-label="FluiDimensions home">
          <img src="/logo-sm.webp" alt="" width="35" height="40" decoding="async" class="h-10 w-auto" />
          <div>
            <span class="block font-heading text-base font-black leading-none">FLUIDIMENSIONS</span>
            <span class="mt-1 block text-[9px] font-bold uppercase tracking-widest text-accent">Understand. Optimise. Innovate.</span>
          </div>
        </a>
        <p class="max-w-sm text-sm leading-6 text-slate-400">Integrated engineering consulting and technology-driven solutions to help industries understand complex processes, improve equipment performance and solve challenging engineering problems.</p>
      </div>
      {columns.map((column) => (
        <div class={column.title === 'Industries' ? 'col-span-2 lg:col-span-1' : ''}>
          <h2 class="mb-2 font-heading text-xs font-bold uppercase tracking-widest text-accent lg:mb-3">{column.title}</h2>
          <ul class:list={['font-body text-sm text-slate-400 lg:text-[0.8125rem]', column.title === 'Industries' && 'grid grid-cols-2 gap-x-5 lg:block']}>
            {column.links.map(([label, to]) => <li><a href={to} class="inline-flex min-h-11 items-center transition hover:text-white lg:min-h-0 lg:py-1">{label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class="flex flex-col items-center gap-4 border-t border-white/5 pt-5 text-center sm:flex-row sm:justify-start sm:gap-8 sm:text-left">
      <div class="flex flex-col items-center gap-2 text-xs leading-5 text-slate-500 sm:flex-row sm:gap-5"><span>© {new Date().getFullYear()} FluiDimensions. All rights reserved.</span><a href="/privacy-policy/" class="inline-flex min-h-11 items-center lg:min-h-0 transition hover:text-white lg:min-h-0 lg:py-1">Privacy Policy</a></div>
      <div class="flex gap-3 sm:order-first">
        {socials.map((social) => (
          <a href={social.href} target="_blank" rel="noreferrer" aria-label={`FluiDimensions on ${social.label}`} class="transition hover:-translate-y-0.5">
            <span class:list={['inline-flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-tr text-white shadow-md', social.tone]}><Icon name={social.icon} class="h-[18px] w-[18px]" aria-hidden="true" /></span>
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
