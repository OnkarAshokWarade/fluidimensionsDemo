---
// Illustrative 3D flow in a stirred reactor tank (kinematic model, not project data). Borderless, no controls.
---
<figure class="reactor-viz relative w-full" data-reactor-viz>
  <div class="relative aspect-[4/5] max-h-[34rem] min-h-[20rem] w-full max-w-[28rem] lg:max-h-[28rem] lg:min-h-0 lg:-my-6 mx-auto lg:mx-0 lg:ml-auto">
    <canvas class="block h-full w-full cursor-grab touch-pan-y" role="img" aria-label="Animated 3D visualisation of fluid circulating in a stirred reactor tank with a rotating impeller and baffles, coloured by velocity"></canvas>
    <p data-reactor-fallback class="absolute inset-0 hidden place-content-center p-6 text-center text-sm text-slate-300">The 3D view is not available in this browser.</p>
  </div>
</figure>

<script>
  import type { WebGLRenderer } from 'three';

  // Start downloading three.js right away so the animation can appear without delay.
  const threeReady = import('three');
  // Load three.js only when the animation is about to be seen, and after the page has painted.
  const whenNear = (el: Element, cb: () => void) => {
    let done = false;
    const go = () => { if (done) return; done = true; cb(); };
    if (!('IntersectionObserver' in window)) return go();
    const io = new IntersectionObserver((entries) => { if (entries.some((e) => e.isIntersecting)) { io.disconnect(); go(); } }, { rootMargin: '400px' });
    io.observe(el);
  };

  const lazyRoot = document.querySelector<HTMLElement>('[data-reactor-viz]');
  if (lazyRoot) whenNear(lazyRoot, async () => {
    const { WebGLRenderer, Scene, PerspectiveCamera, Mesh, MeshBasicMaterial, CylinderGeometry, CircleGeometry, BoxGeometry, Group, Line, LineSegments, LineBasicMaterial, BufferGeometry, BufferAttribute, DynamicDrawUsage, Vector3, DoubleSide, GridHelper } = await threeReady;
  
    
  
    const root = document.querySelector<HTMLElement>('[data-reactor-viz]');
    if (root) {
      const canvas = root.querySelector('canvas')!;
      const fb = root.querySelector<HTMLElement>('[data-reactor-fallback]')!;
      let renderer: WebGLRenderer | null = null;
      try { renderer = new WebGLRenderer({ canvas, antialias: true, alpha: true }); } catch { fb.classList.remove('hidden'); fb.classList.add('grid'); }
      if (renderer) init(renderer, root.querySelector<HTMLElement>('.relative')!);
    }
  
    function init(renderer: WebGLRenderer, stage: HTMLElement) {
      const canvas = renderer.domElement;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));
      const scene = new Scene();
      const camera = new PerspectiveCamera(36, 4 / 5, 0.1, 100);
  
      const R = 1.6, H = 4.4, ZB = -H / 2, ZT = H / 2, Z0 = -0.6, RI = 0.55;
      const stops: [number, number[]][] = [[0, [30, 64, 230]], [.22, [0, 170, 255]], [.42, [0, 220, 130]], [.6, [140, 230, 40]], [.78, [255, 200, 0]], [1, [255, 40, 20]]];
      const cmap = (v: number) => {
        v = Math.max(0, Math.min(1, v));
        for (let i = 1; i < stops.length; i++) {
          if (v <= stops[i][0]) { const a = stops[i - 1], b = stops[i], k = (v - a[0]) / (b[0] - a[0]); return [0, 1, 2].map((n) => a[1][n] + (b[1][n] - a[1][n]) * k); }
        }
        return stops[4][1];
      };
  
      // Tank
      const mat = (color: number, opacity?: number) => new MeshBasicMaterial({ color, ...(opacity ? { transparent: true, opacity, side: DoubleSide, depthWrite: false } : {}) });
      scene.add(new Mesh(new CylinderGeometry(R, R, H, 48, 1, true), mat(0x1D63C8, 0.08)));
      const ring = (y: number) => {
        const pts: Vector3[] = [];
        for (let i = 0; i <= 64; i++) { const th = i / 64 * Math.PI * 2; pts.push(new Vector3(R * Math.cos(th), y, R * Math.sin(th))); }
        return new Line(new BufferGeometry().setFromPoints(pts), new LineBasicMaterial({ color: 0x7FB0F0, transparent: true, opacity: .8 }));
      };
      scene.add(ring(ZT), ring(ZB));
      const ribs: Vector3[] = [];
      for (let k = 0; k < 16; k++) { const th = k / 16 * Math.PI * 2; ribs.push(new Vector3(R * Math.cos(th), ZB, R * Math.sin(th)), new Vector3(R * Math.cos(th), ZT, R * Math.sin(th))); }
      scene.add(new LineSegments(new BufferGeometry().setFromPoints(ribs), new LineBasicMaterial({ color: 0x3A5C8E, transparent: true, opacity: .55 })));
      for (let b = 0; b < 4; b++) {
        const th = b * Math.PI / 2 + Math.PI / 4;
        const bf = new Mesh(new BoxGeometry(0.16, H, 0.03), mat(0x2A4A7A));
        bf.position.set((R - 0.08) * Math.cos(th), 0, (R - 0.08) * Math.sin(th)); bf.rotation.y = -th; scene.add(bf);
      }
      const floorGeo = new CircleGeometry(R, 48); floorGeo.rotateX(-Math.PI / 2);
      const floor = new Mesh(floorGeo, mat(0x0E2A52, 0.75)); floor.position.y = ZB; scene.add(floor);
      const grid = new GridHelper(2 * R, 12, 0x2A4A7A, 0x1B3560); grid.position.y = ZB + 0.005; scene.add(grid);
      const shaft = new Mesh(new CylinderGeometry(0.07, 0.07, H + 0.4, 16), mat(0x9FB3CF)); shaft.position.y = 0.2; scene.add(shaft);
      const imp = new Group(); imp.position.y = Z0;
      imp.add(new Mesh(new CylinderGeometry(0.28, 0.28, 0.04, 32), mat(0xFF6B00)));
      for (let i = 0; i < 6; i++) {
        const bl = new Mesh(new BoxGeometry(0.3, 0.26, 0.035), mat(0xFF8A33)); const a = i / 6 * Math.PI * 2;
        bl.position.set(Math.cos(a) * 0.43, 0, Math.sin(a) * 0.43); bl.rotation.y = -a + Math.PI / 2; imp.add(bl);
      }
      scene.add(imp);
  
      // Particles with trails
      const N = 1300, T = 18, VMAX = 2.3;
      const pos = new Float32Array(N * 3), spd = new Float32Array(N), age = new Float32Array(N), hist = new Float32Array(N * T * 3);
      const segPos = new Float32Array(N * (T - 1) * 6), segCol = new Float32Array(N * (T - 1) * 6);
      const geo = new BufferGeometry();
      geo.setAttribute('position', new BufferAttribute(segPos, 3).setUsage(DynamicDrawUsage));
      geo.setAttribute('color', new BufferAttribute(segCol, 3).setUsage(DynamicDrawUsage));
      const lines = new LineSegments(geo, new LineBasicMaterial({ vertexColors: true, transparent: true, opacity: .95 }));
      lines.frustumCulled = false; lines.renderOrder = 2; scene.add(lines);
  
      const spawn = (p: number, anywhere: boolean) => {
        const r = Math.sqrt(Math.random()) * (R - 0.1), th = Math.random() * Math.PI * 2;
        pos[p * 3] = r * Math.cos(th);
        pos[p * 3 + 1] = anywhere ? ZB + 0.1 + Math.random() * (H - 0.2) : (Math.random() < .5 ? Z0 + (Math.random() - .5) * 0.3 : ZB + 0.15 + Math.random() * (H - 0.3));
        pos[p * 3 + 2] = r * Math.sin(th);
        age[p] = -Math.random() * 2;
        for (let q = 0; q < T; q++) for (let n = 0; n < 3; n++) hist[(p * T + q) * 3 + n] = pos[p * 3 + n];
      };
      for (let p = 0; p < N; p++) spawn(p, true);
  
      const move = (p: number, dt: number, t: number) => {
        const x = pos[p * 3], y = pos[p * 3 + 1], z = pos[p * 3 + 2];
        const r = Math.sqrt(x * x + z * z) || 1e-4, th = Math.atan2(z, x);
        const dz = y - Z0, jet = Math.exp(-(dz * dz) / (2 * 0.28 * 0.28)), rn = r / R;
        let vth = 2.1 * r * Math.exp(-0.9 * rn * rn) * (0.7 + 0.5 * jet);
        const sm = Math.max(0, Math.min(1, (Math.abs(dz) - 0.7) / 0.8));
        const vr = 2.4 * jet * Math.min(1, r / RI) * (1 - 0.35 * rn) - 1.2 * rn * sm;
        const vy = 0.95 * Math.tanh(dz / 0.5) * (rn - 0.45) * (1 - jet) - 0.05;
        vth *= 1 + 0.12 * Math.sin(4 * th + t);
        spd[p] = Math.sqrt(vth * vth + vr * vr + vy * vy);
        let nr = r + vr * dt; const nth = th + (vth / Math.max(r, 0.12)) * dt, ny = y + vy * dt;
        if (nr < 0.16) return false;
        if (nr > R - 0.06) nr = R - 0.06;
        if (ny > ZT - 0.05 || ny < ZB + 0.05) return false;
        age[p] += dt; if (age[p] > 14) return false;
        pos[p * 3] = nr * Math.cos(nth); pos[p * 3 + 1] = ny; pos[p * 3 + 2] = nr * Math.sin(nth);
        return true;
      };
  
      const bg = [7 / 255, 27 / 255, 58 / 255];
      const step = (dt: number, t: number) => {
        for (let p = 0; p < N; p++) {
          if (!move(p, dt, t)) { spawn(p, false); continue; }
          for (let q = T - 1; q > 0; q--) for (let n = 0; n < 3; n++) hist[(p * T + q) * 3 + n] = hist[(p * T + q - 1) * 3 + n];
          hist[p * T * 3] = pos[p * 3]; hist[p * T * 3 + 1] = pos[p * 3 + 1]; hist[p * T * 3 + 2] = pos[p * 3 + 2];
        }
        let w = 0;
        for (let p = 0; p < N; p++) {
          const c = cmap(spd[p] / VMAX);
          for (let q = 0; q < T - 1; q++) {
            for (let e = 0; e < 2; e++) {
              const f = Math.pow(1 - (q + e) / (T - 1), 1.4), a = (p * T + q + e) * 3;
              segPos[w] = hist[a]; segPos[w + 1] = hist[a + 1]; segPos[w + 2] = hist[a + 2];
              for (let n = 0; n < 3; n++) segCol[w + n] = bg[n] + (c[n] / 255 - bg[n]) * f;
              w += 3;
            }
          }
        }
        geo.attributes.position.needsUpdate = true; geo.attributes.color.needsUpdate = true;
        imp.rotation.y = -t * 5.0;
      };
  
      let dragAz = 0, dragEl = 0, dragging = false, lastX = 0, lastY = 0, t = 0, last = performance.now(), visible = true;
      const playing = !reduce;
      const draw = () => {
        const a = 0.5 * Math.sin(t * 0.18) + dragAz, el = 0.34 + dragEl, d = camera.fov > 40 ? 8.6 : 9.6;
        camera.position.set(d * Math.sin(a) * Math.cos(el), 0.1 + d * Math.sin(el), d * Math.cos(a) * Math.cos(el));
        camera.lookAt(0, 0.1, 0);
        renderer.render(scene, camera);
      };
      canvas.addEventListener('pointerdown', (e) => { dragging = true; lastX = e.clientX; lastY = e.clientY; canvas.setPointerCapture(e.pointerId); });
      canvas.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        dragAz -= (e.clientX - lastX) * 0.006; dragEl = Math.max(-.3, Math.min(.9, dragEl + (e.clientY - lastY) * 0.004));
        lastX = e.clientX; lastY = e.clientY; if (!playing) draw();
      });
      const end = () => { dragging = false; };
      canvas.addEventListener('pointerup', end); canvas.addEventListener('pointercancel', end);
  
      const resize = () => {
        const w = stage.clientWidth, h = stage.clientHeight; if (!w || !h) return;
        renderer.setSize(w, h, false); camera.aspect = w / h; camera.fov = w / h < 0.9 ? 42 : 36; camera.updateProjectionMatrix(); draw();
      };
      new ResizeObserver(resize).observe(stage);
      new IntersectionObserver((e) => { visible = e[0].isIntersecting; last = performance.now(); }).observe(stage);
      resize();
      for (let i = 0; i < 60; i++) { t += 0.05; step(0.05, t); }
      draw();
      const loop = (now: number) => {
        const dt = Math.min((now - last) / 1000, 0.05); last = now;
        if (visible && !document.hidden) {
          if (playing) { t += dt; step(dt, t); if (!dragging) { dragAz *= 0.995; dragEl *= 0.995; } }
          draw();
        }
        requestAnimationFrame(loop);
      };
      requestAnimationFrame((n) => { last = n; requestAnimationFrame(loop); });
    }
  
  });
</script>
