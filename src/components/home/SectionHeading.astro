---
interface Props { id?: string; eyebrow?: string; title: string; intro?: string; align?: 'center' | 'left'; dark?: boolean }
const { id, eyebrow, title, intro, align = 'center', dark = false } = Astro.props;
---
<div class:list={['mb-12 max-w-3xl sm:mb-14', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <span class="text-sm font-bold uppercase tracking-widest text-accent">{eyebrow}</span>}
  <h2 id={id} class:list={['mt-2 font-heading text-[clamp(1.75rem,5vw,2.75rem)] font-black leading-tight', dark ? 'text-white' : 'text-primary']}>{title}</h2>
  {intro && <p class:list={['mt-4 font-body text-base leading-relaxed', dark ? 'text-gray-300' : 'text-slate-600']}>{intro}</p>}
</div>
