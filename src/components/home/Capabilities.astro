---
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';
import { capabilitiesSection as content } from '../../data/home';

const tones: Record<string, string> = {
  'capability.simulation': 'from-blue-500 to-sky-400', 'capability.process': 'from-emerald-500 to-teal-400',
  'capability.design': 'from-sky-500 to-indigo-400', 'capability.data': 'from-purple-500 to-violet-400',
  'capability.software': 'from-orange-500 to-accent', 'capability.digital': 'from-teal-500 to-emerald-400',
};
---
<section id="capabilities" aria-labelledby="capabilities-heading" class="bg-brand-bg py-20 sm:py-24 lg:py-28">
  <div class="site-container">
    <SectionHeading id="capabilities-heading" title={content.heading} intro={content.intro} />
    <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {content.cards.map((card, index) => (
        <li class="reveal" style={`--reveal-delay:${index * 0.05}s`}>
          <a href={card.to} class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-accent/30 hover:shadow-xl sm:p-7">
            <span class:list={['mb-5 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-tr text-white shadow-md', tones[card.tone]]}><Icon name={card.icon} class="h-[26px] w-[26px]" aria-hidden="true" /></span>
            <h3 class="font-heading text-lg font-bold text-primary transition-colors group-hover:text-accent">{card.title}</h3>
            <p class="mt-2 flex-1 font-body text-sm leading-relaxed text-slate-600">{card.desc}</p>
            <span class="mt-5 inline-flex items-center gap-1 font-heading text-xs font-bold text-secondary transition-colors group-hover:text-accent">
              Learn more <Icon name="ion:arrow-forward" class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
