---
import SectionHeading from './SectionHeading.astro';
import { valuesSection as content } from '../../data/home';
---
<section id="values" aria-labelledby="values-heading" class="bg-tint py-20 sm:py-24">
  <div class="site-container">
    <SectionHeading id="values-heading" eyebrow="Our values" title={content.heading} />
    <ul class="grid grid-cols-1 gap-5 md:grid-cols-3">
      {content.items.map((item, index) => (
        <li class="reveal" style={`--reveal-delay:${index * 0.06}s`}>
          <div class="h-full rounded-2xl border border-slate-200 bg-white p-7 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-widest text-accent">{item.title}</p>
            <h3 class="mt-3 font-heading text-lg font-bold text-primary">{item.subtitle}</h3>
            <p class="mt-3 font-body text-sm leading-relaxed text-slate-600">{item.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
