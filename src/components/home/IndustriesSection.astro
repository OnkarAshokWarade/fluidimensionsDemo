---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';
import { industriesSection as content } from '../../data/home';
import chemical from '../../assets/industries/chemical.webp';
import cement from '../../assets/industries/cement-mining.webp';
import pharma from '../../assets/industries/pharmaceutical.webp';
import oilGas from '../../assets/industries/oil-gas.webp';

// TODO(assets): replace with approved real industrial/project imagery (blueprint section 5).
const images: Record<string, ImageMetadata> = {
  '/industries/chemical-process/': chemical,
  '/industries/cement/': cement,
  '/industries/pharmaceuticals/': pharma,
  '/industries/oil-gas/': oilGas,
};
---
<section id="industries" aria-labelledby="industries-heading" class="bg-white py-20 sm:py-24 lg:py-28">
  <div class="site-container">
    <SectionHeading id="industries-heading" title={content.heading} intro={content.intro} />
    <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {content.cards.map((card, index) => (
        <li class="reveal" style={`--reveal-delay:${index * 0.05}s`}>
          <a href={card.path} class="group relative flex h-full min-h-[22rem] flex-col justify-end overflow-hidden rounded-2xl bg-primary p-6 text-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl">
            <Image src={images[card.path]} alt="" widths={[400, 800]} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" loading="lazy" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/80 to-primary/20" aria-hidden="true"></div>
            <div class="relative">
              <h3 class="font-heading text-xl font-bold">{card.label}</h3>
              <p class="mt-2 font-body text-sm leading-relaxed text-slate-200">{card.desc}</p>
              <span class="mt-4 inline-flex items-center gap-1 font-heading text-xs font-bold text-orange-300">
                Explore {card.label} <Icon name="ion:arrow-forward" class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
