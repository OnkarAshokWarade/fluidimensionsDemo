---
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';
import { industriesSection as content } from '../../data/home';
import { INDS, IND, CAPS } from '../../data/doc';
import { industryPages } from '../../data/site';

const icons = ['ion:flask-outline', 'ion:medkit-outline', 'ion:business-outline', 'ion:flame-outline', 'ion:water-outline', 'ion:car-sport-outline', 'ion:airplane-outline', 'ion:boat-outline', 'ion:nutrition-outline'];
// Static class strings so Tailwind can see them.
const tones = [
  { num: 'bg-sky-600', soft: 'bg-sky-50 text-sky-900 border-sky-200', band: 'from-sky-700 to-primary' },
  { num: 'bg-emerald-600', soft: 'bg-emerald-50 text-emerald-900 border-emerald-200', band: 'from-emerald-700 to-primary' },
  { num: 'bg-amber-600', soft: 'bg-amber-50 text-amber-900 border-amber-200', band: 'from-amber-600 to-primary' },
  { num: 'bg-rose-600', soft: 'bg-rose-50 text-rose-900 border-rose-200', band: 'from-rose-700 to-primary' },
  { num: 'bg-violet-600', soft: 'bg-violet-50 text-violet-900 border-violet-200', band: 'from-violet-700 to-primary' },
  { num: 'bg-cyan-600', soft: 'bg-cyan-50 text-cyan-900 border-cyan-200', band: 'from-cyan-700 to-primary' },
];
const items = INDS.map((ind, i) => ({
  id: ind.id,
  label: industryPages[i].label,
  path: industryPages[i].path,
  tag: ind.tag,
  intro: (IND as any)[ind.id]?.intro?.[0] ?? industryPages[i].description,
  focus: ((IND as any)[ind.id]?.areas ?? []).slice(0, 4).map((a: any) => a.t),
  icon: icons[i],
  tone: tones[i % tones.length],
}));
const capabilities = CAPS.filter((c) => c.t !== 'Digital Engineering').map((c) => c.t);
const trim = (text: string, max = 260) => (text.length > max ? `${text.slice(0, max).replace(/\s+\S*$/, '')}…` : text);
---
<section id="industries" aria-labelledby="industries-heading" class="bg-tint py-20 sm:py-24 lg:py-28">
  <div class="site-container">
    <SectionHeading id="industries-heading" eyebrow="Industries" title={content.heading} intro={content.intro} />

    <div class="reveal overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-lg" data-ind-explorer>
      <div class="grid lg:grid-cols-[19rem_minmax(0,1fr)]">
        <!-- Industry list -->
        <div class="border-b border-slate-200 bg-slate-50 p-3 lg:border-b-0 lg:border-r lg:p-4">
          <p class="hidden px-3 pb-2 pt-1 text-xs font-bold uppercase tracking-widest text-slate-500 lg:block">Choose an industry</p>
          <div role="tablist" aria-label="Industries" aria-orientation="vertical" class="grid grid-cols-3 gap-2 sm:grid-cols-5 lg:flex lg:flex-col">
            {items.map((item, i) => (
              <button type="button" role="tab" id={`ind-tab-${item.id}`} aria-controls={`ind-panel-${item.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="ind-tab group flex min-h-[5.25rem] flex-col items-center justify-center gap-1.5 rounded-xl border border-slate-200 bg-white px-1.5 py-2.5 text-center transition hover:border-accent/40 lg:min-h-0 lg:w-full lg:flex-row lg:justify-start lg:gap-3 lg:border-transparent lg:bg-transparent lg:px-3 lg:text-left lg:hover:bg-white">
                <span class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-white ${item.tone.num}`}><Icon name={item.icon} class="h-5 w-5" aria-hidden="true" /></span>
                <span class="font-heading text-[11px] font-semibold leading-tight text-primary min-[400px]:text-xs lg:text-sm">{item.label}</span>
                <Icon name="ion:chevron-forward" class="ml-auto hidden h-4 w-4 text-slate-400 transition group-aria-selected:translate-x-0.5 group-aria-selected:text-accent lg:block" aria-hidden="true" />
              </button>
            ))}
          </div>
        </div>

        <!-- Detail panels -->
        <div class="min-w-0">
          {items.map((item, i) => (
            <div role="tabpanel" id={`ind-panel-${item.id}`} aria-labelledby={`ind-tab-${item.id}`} class:list={['ind-panel scroll-mt-20', i === 0 && 'is-active']} tabindex="0">
              <div class={`bg-gradient-to-br px-6 py-7 text-white sm:px-8 ${item.tone.band}`}>
                <div class="flex items-center gap-4">
                  <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-white/15"><Icon name={item.icon} class="h-8 w-8" aria-hidden="true" /></span>
                  <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-white/70">Industry {String(i + 1).padStart(2, '0')} of {String(items.length).padStart(2, '0')}</p>
                    <h3 class="font-heading text-2xl font-bold leading-tight sm:text-3xl">{item.label}</h3>
                  </div>
                </div>
                <p class="mt-4 max-w-2xl font-heading text-base font-medium text-white/90 sm:text-lg">{item.tag}</p>
              </div>
              <div class="p-6 sm:p-8">
                <p class="max-w-3xl font-body text-sm leading-7 text-slate-600 sm:text-base">{trim(item.intro)}</p>
                {item.focus.length > 0 && (
                  <>
                    <p class="mt-6 text-xs font-bold uppercase tracking-widest text-slate-500">Where we help</p>
                    <ul class="mt-3 grid gap-3 sm:grid-cols-2">
                      {item.focus.map((f: string) => (
                        <li class={`flex items-start gap-2.5 rounded-xl border p-3.5 font-body text-sm font-medium leading-snug ${item.tone.soft}`}><Icon name="ion:checkmark-circle" class="mt-0.5 h-4 w-4 shrink-0" aria-hidden="true" />{f}</li>
                      ))}
                    </ul>
                  </>
                )}
                <p class="mt-6 text-xs font-bold uppercase tracking-widest text-slate-500">Capabilities we bring</p>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {capabilities.map((c) => <li class="rounded-full border border-slate-200 bg-white px-3 py-1 font-body text-xs font-medium text-slate-700">{c}</li>)}
                </ul>
                <a href={item.path} class="mt-7 inline-flex min-h-11 items-center gap-2 rounded-lg bg-accent px-6 font-heading text-sm font-semibold text-white shadow-md transition hover:bg-accent-dark">Explore {item.label} solutions <Icon name="ion:arrow-forward" class="h-4 w-4" aria-hidden="true" /></a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <ul class="mt-8 grid grid-cols-3 gap-3 text-center sm:gap-5">
      <li class="rounded-2xl border border-slate-200 bg-white p-4"><p class="font-heading text-2xl font-bold text-primary sm:text-3xl">{items.length}</p><p class="mt-1 font-body text-xs text-slate-600 sm:text-sm">Industries served</p></li>
      <li class="rounded-2xl border border-slate-200 bg-white p-4"><p class="font-heading text-2xl font-bold text-primary sm:text-3xl">{capabilities.length}</p><p class="mt-1 font-body text-xs text-slate-600 sm:text-sm">Capabilities applied</p></li>
      <li class="rounded-2xl border border-slate-200 bg-white p-4"><p class="font-heading text-2xl font-bold text-accent sm:text-3xl">1</p><p class="mt-1 font-body text-xs text-slate-600 sm:text-sm">Integrated approach</p></li>
    </ul>
  </div>
</section>

<style is:global>
  .js .ind-panel:not(.is-active) { display: none; }
  .ind-tab[aria-selected='true'] { background: #fff; border-color: rgb(255 107 0 / .45); box-shadow: 0 4px 14px rgb(7 27 58 / .08); }
  .ind-panel:focus-visible { outline: 3px solid #7FB0F0; outline-offset: -3px; }
  .ind-panel.is-active { animation: ind-in .35s ease both; }
  @keyframes ind-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .ind-panel.is-active { animation: none; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-ind-explorer]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('.ind-panel')];
    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
      panels.forEach((panel, i) => panel.classList.toggle('is-active', i === index));
      if (focus) tabs[index].focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        select(i);
        // On phones and small tablets the detail sits below the tiles, so bring it into view.
        if (window.matchMedia('(max-width: 1023px)').matches) panels[i].scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      tab.addEventListener('keydown', (e) => {
        const key = (e as KeyboardEvent).key;
        if (key === 'ArrowDown' || key === 'ArrowRight') { e.preventDefault(); select((i + 1) % tabs.length, true); }
        if (key === 'ArrowUp' || key === 'ArrowLeft') { e.preventDefault(); select((i - 1 + tabs.length) % tabs.length, true); }
        if (key === 'Home') { e.preventDefault(); select(0, true); }
        if (key === 'End') { e.preventDefault(); select(tabs.length - 1, true); }
      });
    });
  }
</script>
