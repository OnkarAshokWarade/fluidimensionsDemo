---
import { Icon } from 'astro-icon/components';
import { visionSection as content } from '../../data/home';
---
<section id="vision" aria-labelledby="vision-heading" class="bg-brand-bg py-20 sm:py-24 lg:py-28">
  <div class="site-container grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div class="reveal">
      <p class="text-sm font-bold uppercase tracking-widest text-accent">Vision</p>
      <h2 id="vision-heading" class="mt-3 font-heading text-[clamp(1.5rem,3.4vw,2.25rem)] font-bold leading-snug text-primary">“{content.quote}”</h2>
      <p class="mt-5 font-body text-base leading-relaxed text-slate-600">{content.vision}</p>
    </div>
    <div class="reveal rounded-2xl border border-slate-300 bg-white p-7 shadow-sm sm:p-9">
      <p class="text-xs font-bold uppercase tracking-widest text-accent">Technical leadership</p>
      <h3 class="mt-3 font-heading text-xl font-bold text-primary">{content.leader.heading}</h3>
      <p class="mt-3 font-body text-sm leading-relaxed text-slate-600">{content.leader.body}</p>
      <a href="/about-us/" class="mt-6 inline-flex items-center gap-1 font-heading text-sm font-bold text-secondary hover:text-accent">About FluiDimensions <Icon name="ion:arrow-forward" class="h-4 w-4" aria-hidden="true" /></a>
    </div>
  </div>
</section>
