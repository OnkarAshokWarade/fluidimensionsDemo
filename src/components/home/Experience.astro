---
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';
import { experienceSection as content } from '../../data/home';
---
<section id="experience" aria-labelledby="experience-heading" class="bg-brand-bg py-20 sm:py-24 lg:py-28">
  <div class="site-container">
    <SectionHeading id="experience-heading" eyebrow="Selected experience" title={content.heading} intro={content.intro} />
    <ul class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      {content.projects.map((project, index) => (
        <li class="reveal" style={`--reveal-delay:${(index % 3) * 0.05}s`}>
          <article class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex flex-wrap gap-2">
              <span class="rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-secondary">{project.sec}</span>
              <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">{project.cap}</span>
            </div>
            <p class="mt-4 font-heading text-2xl font-bold leading-tight text-primary">{project.big}</p>
            <h3 class="mt-2 font-heading text-base font-semibold text-slate-800">{project.t}</h3>
            <p class="mt-2 flex-1 font-body text-sm leading-relaxed text-slate-600">{project.d}</p>
            <a href={project.to} class="mt-5 inline-flex items-center gap-1 font-heading text-xs font-bold text-secondary hover:text-accent">Read more <Icon name="ion:arrow-forward" class="h-4 w-4" aria-hidden="true" /></a>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>
