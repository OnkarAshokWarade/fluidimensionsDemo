---
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';
import { whySection as content } from '../../data/home';
---
<section id="why-fluidimensions" aria-labelledby="why-heading" class="bg-brand-bg py-20 sm:py-24 lg:py-28">
  <div class="site-container">
    <SectionHeading id="why-heading" eyebrow="Why FluiDimensions" title={content.heading} />
    <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:gap-8">
      {content.items.map((item, index) => (
        <li class="reveal" style={`--reveal-delay:${index * 0.05}s`}>
          <div class="flex h-full gap-5 rounded-2xl border border-slate-200 bg-white p-6 sm:p-7">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-secondary/10 text-secondary"><Icon name={item.icon} class="h-6 w-6" aria-hidden="true" /></span>
            <div>
              <h3 class="font-heading text-lg font-bold text-primary">{item.title}</h3>
              <p class="mt-2 font-body text-sm leading-relaxed text-slate-600">{item.desc}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
