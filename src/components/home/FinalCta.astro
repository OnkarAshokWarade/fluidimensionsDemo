---
import { Icon } from 'astro-icon/components';
import { finalCta as content } from '../../data/home';
import { CONTACT_BUSINESS, CONTACT_PATH } from '../../data/site';
---
<!-- Same rounded navy call-to-action card as the inner pages, set on the light page background. -->
<section id="start-a-conversation" aria-labelledby="final-cta-heading" class="bg-brand-bg pb-16 pt-2 sm:pb-20 lg:pb-24">
  <div class="site-container">
    <div class="overflow-hidden rounded-3xl bg-primary px-6 py-12 text-center sm:px-12 sm:py-14">
      <h2 id="final-cta-heading" class="mx-auto max-w-2xl font-heading text-2xl font-bold text-white sm:text-3xl">{content.heading}</h2>
      <p class="mx-auto mt-4 max-w-2xl font-body text-base leading-7 text-slate-300">{content.body}</p>
      <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-5">
        <a href={CONTACT_BUSINESS} class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-lg bg-accent px-7 font-heading text-sm font-semibold text-white transition hover:bg-accent-dark sm:w-auto">
          {content.primary} <Icon name="ion:arrow-forward" class="h-4 w-4" aria-hidden="true" />
        </a>
        <a href={CONTACT_PATH} class="inline-flex min-h-11 items-center justify-center font-heading text-sm font-semibold text-white underline-offset-4 hover:text-orange-300 hover:underline">{content.secondary}</a>
      </div>
    </div>
  </div>
</section>
