---
import { Icon } from 'astro-icon/components';
import { hero, capabilitiesSection } from '../../data/home';
import { industryPages } from '../../data/site';
import { CONTACT_BUSINESS } from '../../data/site';
import TerrainViz from './TerrainViz.astro';
import HeroCapabilities from './HeroCapabilities.astro';
const stats = [
  [String(capabilitiesSection.cards.length), 'capability areas'],
  [String(industryPages.length), 'industries served'],
  ['1', 'integrated approach'],
];
---
<section id="home" aria-labelledby="hero-heading" class="relative isolate overflow-hidden bg-primary lg:h-[min(100svh,920px)] lg:min-h-[640px]">
  <TerrainViz />
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-primary via-primary/65 to-primary/10 lg:bg-gradient-to-r lg:from-primary lg:via-primary/90 lg:via-30% lg:to-transparent lg:to-60%" aria-hidden="true"></div>

  <div class="site-container relative z-10 flex items-start pb-10 pt-32 sm:pt-36 lg:h-full lg:pb-12 lg:pt-32">
    <div class="max-w-xl">
      <p class="mb-4 text-xs font-bold uppercase tracking-[0.18em] text-accent">{hero.eyebrow}</p>
      <h1 id="hero-heading" class="text-balance font-heading text-[clamp(1.5rem,2.5vw,2.25rem)] font-bold leading-[1.1] text-white">
        {hero.h1.split('. ')[0]}. <span class="text-accent">{hero.h1.split('. ').slice(1).join('. ')}</span>
      </h1>
      <p class="mt-5 max-w-lg font-body text-base leading-7 text-slate-300">{hero.body}</p>
      <div class="mt-7 flex flex-col gap-3 min-[480px]:flex-row">
        <a href={CONTACT_BUSINESS} class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-accent px-7 font-heading text-sm font-semibold text-white shadow-lg transition hover:bg-accent-dark">
          Discuss an Engineering Challenge <Icon name="ion:arrow-forward" class="h-4 w-4" aria-hidden="true" />
        </a>
        <a href="/#capabilities" class="inline-flex min-h-12 items-center justify-center rounded-lg border border-white/30 bg-primary/40 px-7 font-heading text-sm font-semibold text-white transition hover:bg-white/10">Explore Our Capabilities</a>
      </div>
    </div>
  </div>

  <div class="site-container relative z-10 pb-6 lg:absolute lg:inset-x-0 lg:bottom-8 lg:pb-0">
    <div class="max-w-[40rem]"><HeroCapabilities /></div>
  </div>

  <div class="site-container relative z-10 pb-8 lg:contents"><ul class="grid max-w-md grid-cols-3 gap-3 lg:absolute lg:bottom-8 lg:right-[max(1.5rem,calc((100%-84rem)/2+3rem))] lg:w-[28.5rem] lg:max-w-none" aria-label="At a glance" data-stats>
    {stats.map(([value, label]) => (
      <li class="rounded-xl border border-white/15 bg-primary/70 px-4 py-3.5 backdrop-blur-md">
        <span class="block font-heading text-3xl font-bold leading-none text-accent tabular-nums">{value}</span>
        <span class="mt-1.5 block font-body text-xs leading-snug text-slate-300">{label}</span>
      </li>
    ))}
  </ul></div>
</section>
