---
import SectionHeading from './SectionHeading.astro';
import { approachSection as content } from '../../data/home';
---
<section id="approach" aria-labelledby="approach-heading" class="relative overflow-hidden bg-primary py-20 sm:py-24 lg:py-28">
  <div class="cfd-grid pointer-events-none absolute inset-0 opacity-5" aria-hidden="true"></div>
  <div class="site-container relative">
    <SectionHeading id="approach-heading" title={content.heading} intro={content.intro} dark />
    <ol class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {content.steps.map((step, index) => (
        <li class="reveal" style={`--reveal-delay:${index * 0.08}s`}>
          <div class="h-full rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
            <span class="font-heading text-4xl font-black text-accent/80" aria-hidden="true">{step.n}</span>
            <h3 class="mt-3 font-heading text-lg font-bold text-white">{step.title}</h3>
            <p class="mt-2 font-body text-sm leading-relaxed text-slate-300">{step.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
