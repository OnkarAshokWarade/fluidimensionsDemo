# Public site URL (used for canonical links, sitemap, RSS). Set in Vercel.
PUBLIC_SITE_URL=https://www.fluidimensions.com

# Sanity (the defaults below match the FluiDimensions project; override only if it changes)
PUBLIC_SANITY_PROJECT_ID=wwt4wlxz
PUBLIC_SANITY_DATASET=production

# Contact forms post here (Formspree, Web3Forms, or similar). Without it, forms show a "not connected" message.
# Resume uploads need a service/plan that accepts file attachments.
PUBLIC_FORM_ENDPOINT=
# Shown only when sending fails; confirm the address before setting.
PUBLIC_CONTACT_EMAIL=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Analytics loads only when set.
PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification token (the content value only).
PUBLIC_GSC_VERIFICATION=
